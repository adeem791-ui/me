+ImageId TextureCache::FindStandaloneImage(ImageDesc& desc) {
+	auto& command = m_scheduler.Current();
+	if (command.IsInvalid()) {
+		EXIT("TextureCache: image lookup requires a valid command buffer\n");
+	}
+	ValidateImageDesc(desc);
+	EXIT_IF(desc.info.data.Empty());
+	const auto metadata_base_layer = desc.view_info.base_layer;
+
+	ImageId result {};
+	{
+		std::scoped_lock lock {m_lock};
+		const auto       candidates =
+		    FindImagesInRegion(desc.info.data.address, desc.info.data.size, false);
+		// Reuse only an image with the exact same guest layout. No view, slice or expansion of
+		// another image is made, because the base is not a block boundary of that image.
+		for (const auto id: candidates) {
+			const auto& image = m_slot_images[id];
+			if (!image.depth_id && SameBacking(image.info, desc.info, false)) {
+				result = id;
+				break;
+			}
+		}
+		if (!result) {
+			result         = InsertImage(desc.info);
+			auto& inserted = m_slot_images[result];
+			if (m_buffer_cache.HasGpuDirtyBytes(inserted.info.data.address,
+			                                    inserted.info.data.size)) {
+				inserted.MarkBufferModified();
+			}
+		}
+		auto& image              = m_slot_images[result];
+		image.tick_accessed_last = m_scheduler.CurrentTick();
+		TouchImage(image);
+	}
+	MaterializeColorClear(result, desc, metadata_base_layer);
+	return result;
+}
