diff --git a/src/graphics/host_gpu/renderer/cache/textureCache.cpp b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
index b6656456..8ebbdaa5 100644
--- a/src/graphics/host_gpu/renderer/cache/textureCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
@@ -128,12 +128,22 @@ TextureCache::TextureCache(GraphicContext& graphics, CommandScheduler& scheduler
 		constexpr int64_t GiB = 1024ll * 1024 * 1024;
 		const auto        budget =
 		    static_cast<int64_t>(std::min<uint64_t>(m_graphics.GetTotalMemoryBudget(), INT64_MAX));
-		const auto threshold = std::min<int64_t>(budget, 8 * GiB);
-		m_pressure_gc_memory = static_cast<uint64_t>(
-		    std::max<int64_t>(std::min(budget - 6 * threshold / 10, budget - GiB), GiB + GiB / 2));
-		m_critical_gc_memory = static_cast<uint64_t>(
-		    std::max<int64_t>(std::min(budget - 2 * threshold / 10, budget - GiB / 2), 3 * GiB));
-		m_trigger_gc_memory = static_cast<uint64_t>(std::max<int64_t>((budget - threshold) / 2, 0));
+		// Measured on Yotei (RTX 5080): a single scene load can create >30k new images
+		// (~10 GB) within one 5-second window. An evicted image's VRAM is reclaimed only
+		// once the GPU catches up to the tick it was still in use at (see DeleteImage's
+		// DeferOperation), so eviction run mid-burst does not free memory immediately --
+		// it can only keep steady-state usage low enough beforehand to leave headroom for
+		// the next burst. The old thresholds left ~10% of budget as headroom once
+		// "critical" (aggressive eviction) engaged, which a multi-GB burst blows through
+		// before the periodic submission-boundary check (graphicsRun.cpp) can catch up.
+		// Start light eviction at 35% of budget, aggressive eviction at 65%, instead of
+		// ~79%/~89%, to leave roughly 3x the headroom.
+		m_trigger_gc_memory =
+		    static_cast<uint64_t>(std::max<int64_t>(budget * 35 / 100, GiB));
+		m_pressure_gc_memory =
+		    static_cast<uint64_t>(std::max<int64_t>(budget * 50 / 100, GiB + GiB / 2));
+		m_critical_gc_memory =
+		    static_cast<uint64_t>(std::max<int64_t>(budget * 65 / 100, 2 * GiB));
 	}
 }
 
