+#ifndef KERNEL_MAIN_THREAD_SAMPLER_H_
+#define KERNEL_MAIN_THREAD_SAMPLER_H_
+
+// Where the guest main thread is executing after a named thread is joined. Diagnostic only.
+//
+// Each successful join of a thread named KYTY_STALL_PROBE_JOIN (default "GameState") starts a
+// sampling campaign of the guest main thread, run from a thread of its own. A campaign is a
+// fixed series of bursts (BurstOffsetsS after the join); each burst briefly suspends the main
+// thread SamplesPerBurst times, SampleIntervalMs apart, and for each sample copies its
+// registers and the top StackBytes of its stack, then resumes it at once. Everything else
+// (naming addresses, decoding call sites, logging) happens after the resume, on the sampler
+// thread, so a suspended thread is never waited on and nothing is allocated or locked while it
+// is suspended.
+//
+// Every ResumeThread is checked and retried (ResumeAttempts); if the thread cannot be resumed,
+// sampling is first disabled for the rest of the run and any queued campaign dropped, and only then
+// is the failure logged (HandleResumeExhausted). Each pause is timed, and every
+// burst line reports the pauses' minimum, median, maximum and total, so the probe's own impact can
+// be checked in the log.
+//
+// Bounds: MaxCampaigns campaigns per run; a new matching join ends the running campaign and
+// starts the next; per burst one summary line, at most PrintedSamplesPerBurst sample lines and,
+// when the busiest location changes, a register line, a register-target line and a code line.
+//
+// Windows only (SuspendThread/GetThreadContext); elsewhere it says so once and samples nothing.
+// It changes nothing in the emulator. KYTY_STALL_PROBE=0 turns it off, KYTY_STALL_PROBE_CODE=0
+// leaves out the code bytes (a few instructions of the game around the busiest address).
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace Libs::MainThreadSampler {
+
+// Called by PthreadJoin after a successful join, on the joining thread, before the joined
+// thread's handle can be reused. Returns at once.
+void NoteJoin(const char* joined_name, int joiner_id, uint64_t main_host_tid, int main_id);
+
+namespace Detail {
+
+// Burst start times, in seconds after the join.
+inline constexpr uint32_t BurstOffsetsS[]  = {0, 1, 2, 4, 8, 15, 30, 60, 120, 240, 480, 900, 1800};
+inline constexpr uint32_t BurstCount       = sizeof(BurstOffsetsS) / sizeof(BurstOffsetsS[0]);
+inline constexpr uint32_t SamplesPerBurst  = 32;
+inline constexpr uint32_t SampleIntervalMs = 5;
+inline constexpr uint32_t PrintedSamplesPerBurst = 8;
+inline constexpr uint32_t MaxCampaigns           = 6;
+inline constexpr uint32_t StackBytes             = 4096;
+inline constexpr uint32_t MaxCallers             = 3;
+inline constexpr uint32_t TopLocations           = 5;
+inline constexpr uint32_t CodeBytesBefore        = 16;
+inline constexpr uint32_t CodeBytesAfter         = 32;
+// A register "matches" a long wait_reg_mem address when it is this close to it. A match is a lead;
+// no match is inconclusive (the game may compute the address from a base and an offset, or keep
+// it in memory rather than in a register).
+inline constexpr uint64_t WaitAddressSlack = 0x100;
+// ResumeThread calls before the sampler gives up on resuming a sample and stops sampling.
+inline constexpr uint32_t ResumeAttempts = 4;
+
+// Where one sample's instruction pointer is.
+enum class Kind : uint8_t {
+	Guest,     // inside a loaded guest module's segments
+	GuestStub, // inside a guest module's mapping but past its segments: instruction
+	           // trampolines or the TLS handler the emulator generated
+	Emulator,  // the emulator's own executable (HLE functions and everything else in it)
+	OsWait,    // a system call stub that blocks: a wait, a sleep, a message wait
+	OsYield,   // NtYieldExecution: gives up the CPU but stays runnable
+	HostOther, // any other host module: system DLLs, the C runtime, the GPU driver
+	Unknown,   // none of the above (anonymous memory, unmapped)
+	Failed,    // the sample itself failed
+};
+inline constexpr uint32_t KindCount = 8;
+
+inline const char* KindName(Kind kind) {
+	switch (kind) {
+		case Kind::Guest: return "guest";
+		case Kind::GuestStub: return "guest_stub";
+		case Kind::Emulator: return "emulator";
+		case Kind::OsWait: return "os_wait";
+		case Kind::OsYield: return "os_yield";
+		case Kind::HostOther: return "host_other";
+		case Kind::Unknown: return "unknown";
+		case Kind::Failed: return "failed";
+	}
+	return "?";
+}
+
+inline bool EqualsIgnoreCase(const char* a, const char* b) {
+	for (; *a != '\0' && *b != '\0'; a++, b++) {
+		const char ca = (*a >= 'A' && *a <= 'Z') ? static_cast<char>(*a - 'A' + 'a') : *a;
+		const char cb = (*b >= 'A' && *b <= 'Z') ? static_cast<char>(*b - 'A' + 'a') : *b;
+		if (ca != cb) {
+			return false;
+		}
+	}
+	return *a == *b;
+}
+
+// A host instruction pointer, by module and the nearest export at or below it. A blocked
+// thread's instruction pointer sits just after the `syscall` in one of these exported stubs,
+// so the name is exact there; elsewhere the nearest export is only a landmark.
+inline Kind ClassifyHost(bool is_emulator_module, const char* module_name,
+                         const char* export_name) {
+	if (is_emulator_module) {
+		return Kind::Emulator;
+	}
+	const bool ntdll  = module_name != nullptr && EqualsIgnoreCase(module_name, "ntdll.dll");
+	const bool win32u = module_name != nullptr && EqualsIgnoreCase(module_name, "win32u.dll");
+	if ((ntdll || win32u) && export_name != nullptr &&
+	    (std::strncmp(export_name, "Nt", 2) == 0 || std::strncmp(export_name, "Zw", 2) == 0)) {
+		const char* rest = export_name + 2;
+		if (std::strcmp(rest, "YieldExecution") == 0) {
+			return Kind::OsYield;
+		}
+		static constexpr const char* WaitPrefixes[] = {
+		    "WaitFor",        // WaitForSingleObject, ...MultipleObjects, ...AlertByThreadId,
+		                      // ...KeyedEvent, ...WorkViaWorkerFactory
+		    "DelayExecution", // Sleep
+		    "RemoveIoCompletion",
+		    "SignalAndWait",
+		    "UserMsgWaitFor",
+		    "UserGetMessage",
+		    "UserWaitMessage",
+		    "ReplyWaitReceivePort",
+		    "AlpcSendWaitReceivePort",
+		};
+		for (const char* prefix: WaitPrefixes) {
+			if (std::strncmp(rest, prefix, std::strlen(prefix)) == 0) {
+				return Kind::OsWait;
+			}
+		}
+	}
+	return Kind::HostOther;
+}
+
+// --- Call sites --------------------------------------------------------------------------
+
+enum class CallForm : uint8_t {
+	None,        // the bytes before the address are not a call: not a return address
+	Rel32,       // E8 rel32: `value` is the call target
+	RipIndirect, // FF 15 disp32 (call [rip+disp]): `value` is the address of the pointer
+	Indirect,    // call through a register or other memory operand: target unknown
+};
+
+struct CallSite {
+	CallForm form  = CallForm::None;
+	uint64_t value = 0;
+};
+
+inline int32_t ReadI32(const uint8_t* p) {
+	uint32_t v = 0;
+	std::memcpy(&v, p, sizeof(v));
+	return static_cast<int32_t>(v);
+}
+
+// `before` holds the 7 bytes that end at `ret` (before[6] is the byte at ret - 1). Says whether
+// they end with a call instruction, so that `ret` would be its return address.
+inline CallSite DecodeCallBefore(const uint8_t before[7], uint64_t ret) {
+	CallSite site;
+	if (before[2] == 0xE8) { // E8 rel32
+		site.form  = CallForm::Rel32;
+		site.value = ret + static_cast<uint64_t>(static_cast<int64_t>(ReadI32(before + 3)));
+		return site;
+	}
+	if (before[1] == 0xFF && before[2] == 0x15) { // FF 15 disp32
+		site.form  = CallForm::RipIndirect;
+		site.value = ret + static_cast<uint64_t>(static_cast<int64_t>(ReadI32(before + 3)));
+		return site;
+	}
+	// FF /2 with other operands. ModRM reg field 2 = call.
+	const auto is_call_modrm = [](uint8_t modrm, uint8_t mod) {
+		return (modrm >> 6u) == mod && ((modrm >> 3u) & 7u) == 2u;
+	};
+	const bool reg  = before[5] == 0xFF && is_call_modrm(before[6], 3); // FF D0+r
+	const bool ind0 = before[5] == 0xFF && is_call_modrm(before[6], 0) && (before[6] & 7u) != 4u &&
+	                  (before[6] & 7u) != 5u; // FF 10+r
+	const bool sib0 = before[4] == 0xFF && is_call_modrm(before[5], 0) && (before[5] & 7u) == 4u &&
+	                  (before[6] & 7u) != 5u; // FF 14 sib
+	const bool d8 =
+	    before[4] == 0xFF && is_call_modrm(before[5], 1) && (before[5] & 7u) != 4u; // FF 50+r d8
+	const bool sib8 =
+	    before[3] == 0xFF && is_call_modrm(before[4], 1) && (before[4] & 7u) == 4u; // FF 54 sib d8
+	const bool d32 =
+	    before[1] == 0xFF && is_call_modrm(before[2], 2) && (before[2] & 7u) != 4u; // FF 90+r d32
+	const bool sib32 =
+	    before[0] == 0xFF && is_call_modrm(before[1], 2) && (before[1] & 7u) == 4u; // FF 94 sib d32
+	if (reg || ind0 || sib0 || d8 || sib8 || d32 || sib32) {
+		site.form = CallForm::Indirect;
+	}
+	return site;
+}
+
+// FF 25 disp32 (jmp [rip+disp]), the shape of a PLT entry. On success `*slot` is the address
+// of the pointer it jumps through.
+inline bool DecodeIndirectJump(const uint8_t stub[6], uint64_t stub_addr, uint64_t* slot) {
+	if (stub[0] != 0xFF || stub[1] != 0x25) {
+		return false;
+	}
+	*slot = stub_addr + 6 + static_cast<uint64_t>(static_cast<int64_t>(ReadI32(stub + 2)));
+	return true;
+}
+
+// --- Guest modules -----------------------------------------------------------------------
+
+struct GuestRange {
+	std::string name;
+	uint64_t    base       = 0;
+	uint64_t    image_end  = 0; // base + segments
+	uint64_t    mapped_end = 0; // base + whole mapping
+};
+
+inline const GuestRange* FindGuest(const std::vector<GuestRange>& ranges, uint64_t addr,
+                                   bool* stub) {
+	for (const auto& range: ranges) {
+		if (addr >= range.base && addr < range.mapped_end) {
+			if (stub != nullptr) {
+				*stub = addr >= range.image_end;
+			}
+			return &range;
+		}
+	}
+	return nullptr;
+}
+
+// Stack words that are return addresses into guest code: a value inside a guest module whose
+// preceding bytes are a call instruction. Found in stack order (innermost first). `read` is
+// bool(uint64_t addr, void* out, size_t size) and must fail safely on unreadable memory.
+template <typename ReadFn>
+uint32_t ScanGuestReturnAddresses(const uint8_t* stack, size_t stack_bytes,
+                                  const std::vector<GuestRange>& guests, ReadFn read,
+                                  uint64_t* rets, CallSite* sites, uint32_t capacity) {
+	uint32_t found = 0;
+	for (size_t offset = 0; offset + 8 <= stack_bytes && found < capacity; offset += 8) {
+		uint64_t value = 0;
+		std::memcpy(&value, stack + offset, sizeof(value));
+		bool stub = false;
+		if (value < 8 || FindGuest(guests, value, &stub) == nullptr || stub) {
+			continue;
+		}
+		uint8_t before[7] = {};
+		if (!read(value - 7, before, sizeof(before))) {
+			continue;
+		}
+		const CallSite site = DecodeCallBefore(before, value);
+		if (site.form == CallForm::None) {
+			continue;
+		}
+		rets[found]  = value;
+		sites[found] = site;
+		found++;
+	}
+	return found;
+}
+
+// The function a call site called, where that can be read: the target of E8, followed through
+// a PLT entry; the pointer of FF 15. 0 when unknown.
+template <typename ReadFn>
+uint64_t ResolveCallee(const CallSite& site, const std::vector<GuestRange>& guests, ReadFn read) {
+	switch (site.form) {
+		case CallForm::Rel32: {
+			uint8_t  stub[6] = {};
+			uint64_t slot    = 0;
+			uint64_t dest    = 0;
+			if (FindGuest(guests, site.value, nullptr) != nullptr &&
+			    read(site.value, stub, sizeof(stub)) &&
+			    DecodeIndirectJump(stub, site.value, &slot) && read(slot, &dest, sizeof(dest))) {
+				return dest;
+			}
+			return site.value;
+		}
+		case CallForm::RipIndirect: {
+			uint64_t dest = 0;
+			return read(site.value, &dest, sizeof(dest)) ? dest : 0;
+		}
+		case CallForm::None:
+		case CallForm::Indirect: break;
+	}
+	return 0;
+}
+
+// --- Host modules ------------------------------------------------------------------------
+
+// The nearest named export at or below `rva` in a PE32+ image laid out as loaded, reading at
+// most `image_size` bytes from `image`. Forwarders are skipped. nullptr if none.
+inline const char* NearestExport(const uint8_t* image, uint32_t image_size, uint32_t rva,
+                                 uint32_t* export_rva) {
+	const auto u16 = [&](uint32_t at, uint16_t* out) {
+		if (at > image_size || image_size - at < 2) {
+			return false;
+		}
+		std::memcpy(out, image + at, 2);
+		return true;
+	};
+	const auto u32 = [&](uint32_t at, uint32_t* out) {
+		if (at > image_size || image_size - at < 4) {
+			return false;
+		}
+		std::memcpy(out, image + at, 4);
+		return true;
+	};
+	uint16_t mz     = 0;
+	uint32_t lfanew = 0;
+	uint32_t pe     = 0;
+	uint16_t magic  = 0;
+	if (!u16(0, &mz) || mz != 0x5A4D || !u32(0x3C, &lfanew) || !u32(lfanew, &pe) ||
+	    pe != 0x00004550 || !u16(lfanew + 24, &magic) || magic != 0x20B) {
+		return nullptr;
+	}
+	const uint32_t optional  = lfanew + 24;
+	uint32_t       dir_count = 0;
+	uint32_t       dir_rva   = 0;
+	uint32_t       dir_size  = 0;
+	if (!u32(optional + 108, &dir_count) || dir_count < 1 || !u32(optional + 112, &dir_rva) ||
+	    !u32(optional + 116, &dir_size) || dir_rva == 0) {
+		return nullptr;
+	}
+	uint32_t functions      = 0;
+	uint32_t names          = 0;
+	uint32_t ordinals       = 0;
+	uint32_t function_count = 0;
+	uint32_t name_count     = 0;
+	if (!u32(dir_rva + 20, &function_count) || !u32(dir_rva + 24, &name_count) ||
+	    !u32(dir_rva + 28, &functions) || !u32(dir_rva + 32, &names) ||
+	    !u32(dir_rva + 36, &ordinals)) {
+		return nullptr;
+	}
+	const char* best_name = nullptr;
+	uint32_t    best_rva  = 0;
+	for (uint32_t i = 0; i < name_count; i++) {
+		uint16_t ordinal  = 0;
+		uint32_t name_rva = 0;
+		uint32_t func_rva = 0;
+		if (!u16(ordinals + i * 2, &ordinal) || ordinal >= function_count ||
+		    !u32(names + i * 4, &name_rva) || !u32(functions + ordinal * 4u, &func_rva)) {
+			return best_name;
+		}
+		const bool forwarder = func_rva >= dir_rva && func_rva < dir_rva + dir_size;
+		if (forwarder || func_rva > rva || (best_name != nullptr && func_rva <= best_rva) ||
+		    name_rva >= image_size) {
+			continue;
+		}
+		// The name must end inside the image.
+		const void* end = std::memchr(image + name_rva, '\0', image_size - name_rva);
+		if (end == nullptr) {
+			continue;
+		}
+		best_name = reinterpret_cast<const char*>(image + name_rva);
+		best_rva  = func_rva;
+	}
+	if (best_name != nullptr && export_rva != nullptr) {
+		*export_rva = best_rva;
+	}
+	return best_name;
+}
+
+// SizeOfImage from a PE32+ header, reading at most `limit` bytes. 0 if not a PE32+ image.
+inline uint32_t PeImageSize(const uint8_t* image, uint32_t limit) {
+	uint32_t lfanew = 0;
+	uint32_t size   = 0;
+	uint16_t magic  = 0;
+	if (limit < 0x40 || image[0] != 'M' || image[1] != 'Z') {
+		return 0;
+	}
+	std::memcpy(&lfanew, image + 0x3C, 4);
+	if (lfanew > limit || limit - lfanew < 24 + 60) {
+		return 0;
+	}
+	std::memcpy(&magic, image + lfanew + 24, 2);
+	if (std::memcmp(image + lfanew, "PE\0\0", 4) != 0 || magic != 0x20B) {
+		return 0;
+	}
+	std::memcpy(&size, image + lfanew + 24 + 56, 4);
+	return size;
+}
+
+// --- HLE functions -----------------------------------------------------------------------
+
+using FunctionList = std::vector<std::pair<uint64_t, std::string>>; // sorted by address
+
+// The function starting at or below `addr`, or nullptr. Only a landmark unless the offset is
+// 0: code that is not an HLE function sits between them.
+inline const std::pair<uint64_t, std::string>* NearestFunction(const FunctionList& sorted,
+                                                               uint64_t            addr) {
+	auto it = std::upper_bound(sorted.begin(), sorted.end(), addr,
+	                           [](uint64_t a, const auto& entry) { return a < entry.first; });
+	if (it == sorted.begin()) {
+		return nullptr;
+	}
+	return &*(it - 1);
+}
+
+// --- Suspension --------------------------------------------------------------------------
+
+struct ResumeOutcome {
+	bool     resumed        = false;
+	uint32_t attempts       = 0; // calls made
+	uint32_t previous_count = 0; // on success: the suspend count before the call (1 = only ours)
+	uint32_t error          = 0; // on failure: the last error
+};
+
+// Calls `resume` until it succeeds or `attempts` calls have failed. `resume` is
+// uint32_t(uint32_t* error): the previous suspend count, or UINT32_MAX with *error set. Retrying is
+// safe: a failed ResumeThread leaves the suspend count unchanged, so a later success resumes the
+// thread exactly once.
+template <typename ResumeFn>
+ResumeOutcome ResumeWithRetry(ResumeFn resume, uint32_t attempts) {
+	ResumeOutcome outcome;
+	while (outcome.attempts < attempts) {
+		outcome.attempts++;
+		uint32_t       error    = 0;
+		const uint32_t previous = resume(&error);
+		if (previous != UINT32_MAX) {
+			outcome.resumed        = true;
+			outcome.previous_count = previous;
+			outcome.error          = 0;
+			return outcome;
+		}
+		outcome.error = error;
+	}
+	return outcome;
+}
+
+// How long the main thread was held, from just before SuspendThread to just after ResumeThread
+// returned: an upper bound on each pause the sampler caused.
+struct PauseStats {
+	uint32_t count     = 0;
+	uint64_t min_ns    = 0;
+	uint64_t median_ns = 0; // upper median for an even count
+	uint64_t max_ns    = 0;
+	uint64_t total_ns  = 0;
+};
+
+inline PauseStats SummarizePauses(const uint64_t* pauses_ns, size_t count) {
+	PauseStats stats;
+	if (count == 0) {
+		return stats;
+	}
+	std::vector<uint64_t> sorted(pauses_ns, pauses_ns + count);
+	std::sort(sorted.begin(), sorted.end());
+	stats.count     = static_cast<uint32_t>(count);
+	stats.min_ns    = sorted.front();
+	stats.max_ns    = sorted.back();
+	stats.median_ns = sorted[count / 2];
+	for (const uint64_t ns: sorted) {
+		stats.total_ns += ns;
+	}
+	return stats;
+}
+
+// --- Burst reading -----------------------------------------------------------------------
+
+struct BurstStats {
+	uint32_t samples            = 0; // attempted
+	uint32_t by_kind[KindCount] = {};
+	uint32_t distinct_rips      = 0;
+	uint64_t guest_span         = 0;    // max - min guest rip within the busiest guest module
+	double   cpu_pct            = -1.0; // main thread CPU time / wall time; < 0 unknown
+	uint32_t top_emulator_entry = 0; // host samples whose emulator entry point is the commonest one
+	uint32_t host_samples       = 0; // emulator + os_wait + os_yield + host_other
+};
+
+inline uint32_t Count(const BurstStats& s, Kind k) {
+	return s.by_kind[static_cast<uint32_t>(k)];
+}
+
+// A one-word reading of a burst; the sample lines are the evidence. Rules, in order:
+//   no_samples           nothing could be sampled
+//   waiting              >= 80% in a blocking system call and CPU < 25%
+//   waiting_cpu_unknown  >= 80% in a blocking system call, CPU time unavailable
+//   guest_spin           >= 90% in guest code within 4 KiB of one place, CPU >= 50% or unknown
+//   polling_emulator     >= 10% guest, >= 10% inside emulator calls, one emulator entry point
+//                        in >= 50% of those, CPU >= 50% or unknown
+//   busy_in_emulator     >= 80% inside emulator calls (a wait call included: many short waits
+//                        that still use the CPU), CPU >= 50% or unknown
+//   varied               anything else: many different places, which is what progress looks like
+inline const char* Verdict(const BurstStats& s) {
+	const uint32_t ok = s.samples - Count(s, Kind::Failed);
+	if (ok == 0) {
+		return "no_samples";
+	}
+	const auto at_least = [&](uint32_t part, uint32_t whole, uint32_t pct) {
+		return whole != 0 && part * 100u >= whole * pct;
+	};
+	const bool     cpu_busy = s.cpu_pct < 0.0 || s.cpu_pct >= 50.0;
+	const uint32_t guest    = Count(s, Kind::Guest) + Count(s, Kind::GuestStub);
+	if (at_least(Count(s, Kind::OsWait), ok, 80) && s.cpu_pct < 25.0) {
+		return s.cpu_pct < 0.0 ? "waiting_cpu_unknown" : "waiting";
+	}
+	if (at_least(guest, ok, 90) && s.guest_span <= 4096 && cpu_busy) {
+		return "guest_spin";
+	}
+	if (at_least(guest, ok, 10) && at_least(s.host_samples, ok, 10) &&
+	    at_least(s.top_emulator_entry, s.host_samples, 50) && cpu_busy) {
+		return "polling_emulator";
+	}
+	if (at_least(s.host_samples, ok, 80) && cpu_busy) {
+		return "busy_in_emulator";
+	}
+	return "varied";
+}
+
+// Commonest keys first; ties keep first-seen order. Returns how many entries were filled.
+inline uint32_t TopKeys(const std::vector<std::string>& keys, std::string* top, uint32_t* counts,
+                        uint32_t capacity) {
+	std::vector<std::pair<std::string, uint32_t>> tally;
+	for (const auto& key: keys) {
+		if (key.empty()) {
+			continue;
+		}
+		auto it = std::find_if(tally.begin(), tally.end(),
+		                       [&](const auto& entry) { return entry.first == key; });
+		if (it == tally.end()) {
+			tally.emplace_back(key, 1);
+		} else {
+			it->second++;
+		}
+	}
+	std::stable_sort(tally.begin(), tally.end(),
+	                 [](const auto& a, const auto& b) { return a.second > b.second; });
+	uint32_t n = 0;
+	for (; n < capacity && n < tally.size(); n++) {
+		top[n]    = tally[n].first;
+		counts[n] = tally[n].second;
+	}
+	return n;
+}
+
+// --- Campaign queue ------------------------------------------------------------------------
+
+// One requested campaign: the join that triggered it and the thread to sample.
+struct Request {
+	uint64_t main_host_tid  = 0;
+	int      main_id        = 0;
+	int      joiner_id      = 0;
+	uint32_t campaign       = 0;
+	char     joined[64]     = {};
+	char     local_time[32] = {};
+};
+
+// The hand-off between joins (any thread) and the sampler's worker thread: at most one pending
+// request (a newer join replaces it), the campaign cap, shutdown, and the permanent stop after a
+// resume failure. Platform-independent, so the failure ordering is testable.
+class CampaignQueue {
+public:
+	enum class Outcome { Queued, Disabled, CapReached, Stopping };
+
+	struct Submitted {
+		Outcome  outcome       = Outcome::Stopping;
+		bool     first_refusal = false; // the first Disabled or CapReached refusal of the run
+		uint32_t campaign      = 0;     // when Queued
+	};
+
+	// From the joining thread. `start_worker` is called under the lock, once per run, with the
+	// first queued request.
+	template <typename StartFn>
+	Submitted Submit(Request request, StartFn start_worker) {
+		Submitted result;
+		{
+			std::lock_guard lock(m_mutex);
+			if (m_stop) {
+				result.outcome = Outcome::Stopping;
+				return result;
+			}
+			if (m_disabled) {
+				result.outcome       = Outcome::Disabled;
+				result.first_refusal = !std::exchange(m_disabled_told, true);
+				return result;
+			}
+			if (m_campaigns >= MaxCampaigns) {
+				result.outcome       = Outcome::CapReached;
+				result.first_refusal = !std::exchange(m_cap_told, true);
+				return result;
+			}
+			request.campaign = ++m_campaigns;
+			m_request        = request;
+			m_has_request    = true;
+			result.outcome   = Outcome::Queued;
+			result.campaign  = request.campaign;
+			if (!std::exchange(m_worker_started, true)) {
+				start_worker();
+			}
+		}
+		m_wake.notify_all();
+		return result;
+	}
+
+	// From the worker: the next campaign to run, or false once sampling is stopped or disabled.
+	// The disabled state is checked here, under the lock, before any campaign starts, so a request
+	// that was queued before or raced with a resume failure is dropped, never run.
+	bool Next(Request* out) {
+		std::unique_lock lock(m_mutex);
+		m_wake.wait(lock, [this] { return m_stop || m_disabled || m_has_request; });
+		if (m_stop || m_disabled) {
+			m_has_request = false;
+			return false;
+		}
+		*out          = m_request;
+		m_has_request = false;
+		return true;
+	}
+
+	// From the worker, between bursts: false if shutdown, a newer join or a disable interrupts.
+	bool WaitUntil(std::chrono::steady_clock::time_point when) {
+		std::unique_lock lock(m_mutex);
+		m_wake.wait_until(lock, when, [this] { return m_stop || m_disabled || m_has_request; });
+		return !m_stop && !m_disabled && !m_has_request;
+	}
+
+	[[nodiscard]] const char* Interruption() {
+		std::lock_guard lock(m_mutex);
+		return m_stop ? "stopping" : m_disabled ? "sampling_disabled" : "superseded_by_next_join";
+	}
+
+	// From the worker when every resume retry failed. In one step under the lock: sampling is
+	// disabled for the rest of the run and any queued campaign dropped. Takes no other lock and
+	// calls nothing else. Returns whether a queued campaign was dropped.
+	bool DisableAfterResumeFailure() {
+		bool dropped = false;
+		{
+			std::lock_guard lock(m_mutex);
+			dropped       = m_has_request;
+			m_has_request = false;
+			m_disabled    = true;
+		}
+		m_wake.notify_all();
+		return dropped;
+	}
+
+	void Stop() {
+		{
+			std::lock_guard lock(m_mutex);
+			m_stop = true;
+		}
+		m_wake.notify_all();
+	}
+
+	// Tests only.
+	bool DisabledForTest() {
+		std::lock_guard lock(m_mutex);
+		return m_disabled;
+	}
+	bool PendingForTest() {
+		std::lock_guard lock(m_mutex);
+		return m_has_request;
+	}
+	bool LockFreeForTest() {
+		if (!m_mutex.try_lock()) {
+			return false;
+		}
+		m_mutex.unlock();
+		return true;
+	}
+	// Disabled with a request still pending: a state the queue itself never produces, to check
+	// that Next() refuses on the disabled flag alone.
+	void ForceDisabledKeepingRequestForTest() {
+		std::lock_guard lock(m_mutex);
+		m_disabled = true;
+	}
+
+private:
+	std::mutex              m_mutex;
+	std::condition_variable m_wake;
+	Request                 m_request;
+	bool                    m_has_request    = false;
+	bool                    m_stop           = false;
+	bool                    m_disabled       = false; // after a resume failure, for the whole run
+	bool                    m_disabled_told  = false;
+	bool                    m_cap_told       = false;
+	bool                    m_worker_started = false;
+	uint32_t                m_campaigns      = 0;
+};
+
+// The exhausted-resume path, in the order that matters: first, under the queue's lock, sampling
+// is disabled and any queued campaign dropped; only then, with no lock held, `log(dropped)` runs.
+// If logging never returns (the suspended thread may hold the logger's lock), nothing can sample
+// again: the worker's only way back to sampling is Next(), which refuses.
+template <typename LogFn>
+void HandleResumeExhausted(CampaignQueue& queue, LogFn log) {
+	const bool dropped = queue.DisableAfterResumeFailure();
+	log(dropped);
+}
+
+// The worker thread's body: runs campaigns until the queue stops or is disabled.
+template <typename RunFn>
+void WorkerLoop(CampaignQueue& queue, RunFn run_campaign) {
+	Request request;
+	while (queue.Next(&request)) {
+		run_campaign(request);
+	}
+}
+
+} // namespace Detail
+
+} // namespace Libs::MainThreadSampler
+
+#endif // KERNEL_MAIN_THREAD_SAMPLER_H_
