diff --git a/src/kernel/stallProbe.h b/src/kernel/stallProbe.h
new file mode 100644
index 00000000..26c99c0c
--- /dev/null
+++ b/src/kernel/stallProbe.h
@@ -0,0 +1,117 @@
+#ifndef KERNEL_STALL_PROBE_H_
+#define KERNEL_STALL_PROBE_H_
+
+// Pieces shared by the two halves of the stall probe: the switch, a clock, and the addresses of
+// recent long WAIT_REG_MEM waits, which the main-thread sampler compares its registers with.
+//
+// Diagnostic only. Nothing here changes what the emulator does.
+// KYTY_STALL_PROBE=0 turns the whole probe off: the wait_reg_mem detail lines and the
+// main-thread sampler. Unset or any other value leaves it on.
+
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+
+namespace Libs::StallProbe {
+
+inline constexpr size_t RecentWaitSlots = 8;
+
+namespace Detail {
+
+// -1 = not read yet, 0 = off, 1 = on.
+inline std::atomic<int> g_enabled {-1};
+
+inline std::atomic<uint64_t> g_recent_wait_addrs[RecentWaitSlots] {};
+inline std::atomic<uint32_t> g_recent_wait_next {0};
+
+} // namespace Detail
+
+[[nodiscard]] inline bool Enabled() {
+	int state = Detail::g_enabled.load(std::memory_order_relaxed);
+	if (state < 0) {
+		const char* value = std::getenv("KYTY_STALL_PROBE");
+		state             = (value == nullptr || std::strcmp(value, "0") != 0) ? 1 : 0;
+		// Every thread derives the same value from the same environment.
+		Detail::g_enabled.store(state, std::memory_order_relaxed);
+	}
+	return state != 0;
+}
+
+// Tests only.
+inline void SetEnabledForTest(bool enabled) {
+	Detail::g_enabled.store(enabled ? 1 : 0, std::memory_order_relaxed);
+}
+inline void ResetEnabledForTest() {
+	Detail::g_enabled.store(-1, std::memory_order_relaxed);
+}
+
+inline uint64_t NowUs() {
+	return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+	                                 std::chrono::steady_clock::now().time_since_epoch())
+	                                 .count());
+}
+
+// Called once per long wait, when it becomes long.
+inline void PublishLongWaitAddress(uint64_t addr) {
+	const uint32_t slot =
+	    Detail::g_recent_wait_next.fetch_add(1, std::memory_order_relaxed) % RecentWaitSlots;
+	Detail::g_recent_wait_addrs[slot].store(addr, std::memory_order_relaxed);
+}
+
+// The distinct addresses published so far (the last RecentWaitSlots long waits), in no order.
+inline size_t RecentLongWaitAddresses(uint64_t* out, size_t capacity) {
+	size_t count = 0;
+	for (size_t i = 0; i < RecentWaitSlots && count < capacity; i++) {
+		const uint64_t addr = Detail::g_recent_wait_addrs[i].load(std::memory_order_relaxed);
+		if (addr == 0) {
+			continue;
+		}
+		bool seen = false;
+		for (size_t j = 0; j < count; j++) {
+			seen = seen || out[j] == addr;
+		}
+		if (!seen) {
+			out[count++] = addr;
+		}
+	}
+	return count;
+}
+
+inline void ClearRecentForTest() {
+	for (auto& slot: Detail::g_recent_wait_addrs) {
+		slot.store(0, std::memory_order_relaxed);
+	}
+	Detail::g_recent_wait_next.store(0, std::memory_order_relaxed);
+}
+
+// Wall-clock time as "YYYY-MM-DD HH:MM:SS.mmm", to line up with the external monitors' CSVs.
+inline void LocalTime(char* out, size_t size) {
+	std::snprintf(out, size, "unknown");
+	const auto wall   = std::chrono::system_clock::now();
+	const auto wall_t = std::chrono::system_clock::to_time_t(wall);
+	const auto wall_ms =
+	    std::chrono::duration_cast<std::chrono::milliseconds>(wall.time_since_epoch()).count() %
+	    1000;
+	std::tm tm {};
+#ifdef _WIN32
+	if (localtime_s(&tm, &wall_t) != 0) {
+		return;
+	}
+#else
+	if (localtime_r(&wall_t, &tm) == nullptr) {
+		return;
+	}
+#endif
+	char hms[24] = {};
+	std::strftime(hms, sizeof(hms), "%Y-%m-%d %H:%M:%S", &tm);
+	std::snprintf(out, size, "%s.%03d", hms, static_cast<int>(wall_ms));
+}
+
+} // namespace Libs::StallProbe
+
+#endif // KERNEL_STALL_PROBE_H_
