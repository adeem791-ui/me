diff --git a/src/graphics/guest_gpu/command_processor/waitRegMemProbe.h b/src/graphics/guest_gpu/command_processor/waitRegMemProbe.h
new file mode 100644
index 00000000..7958899e
--- /dev/null
+++ b/src/graphics/guest_gpu/command_processor/waitRegMemProbe.h
@@ -0,0 +1,242 @@
+#ifndef GRAPHICS_GUEST_GPU_COMMAND_PROCESSOR_WAIT_REG_MEM_PROBE_H_
+#define GRAPHICS_GUEST_GPU_COMMAND_PROCESSOR_WAIT_REG_MEM_PROBE_H_
+
+// Full detail of long WAIT_REG_MEM waits. Diagnostic only.
+//
+// FrameTrace (patch 18) names a wait_reg_mem stall but keeps only the low 32 bits of the
+// address and of the value. For every wait that lasts LongWaitUs or more, this logs:
+//
+//   begin          the full address, element size, comparison, reference, mask, the value read,
+//                  the packet's poll interval and operation, the submission and the queue;
+//   still_waiting  at 1 s, 5 s, 30 s, 120 s and 600 s, with the value read then;
+//   value_change   each change of the watched value seen at a poll while the wait is long
+//                  (MaxChangesPerWait per wait, MaxChangeLines per run);
+//   end            how long it lasted, how many times it was evaluated, first and final value,
+//                  and whether it ended satisfied or the processor moved on to another wait.
+//
+// A wait shorter than LongWaitUs logs nothing. At most MaxLongWaits waits are logged per run.
+//
+// It changes nothing: the command processor reads the value, makes its own comparison and
+// suspends exactly as before; this only looks at what it read and decided.
+// KYTY_STALL_PROBE=0 turns it off.
+
+#include "common/logging/log.h"
+#include "graphics/host_gpu/renderer/frameProgress.h"
+#include "kernel/stallProbe.h"
+
+#include <atomic>
+#include <cinttypes>
+#include <cstdint>
+
+namespace Libs::Graphics::WaitRegMemProbe {
+
+inline constexpr uint64_t LongWaitUs        = 200000;
+inline constexpr uint32_t MaxLongWaits      = 64;
+inline constexpr uint32_t MaxChangesPerWait = 16;
+inline constexpr uint32_t MaxChangeLines    = 256;
+inline constexpr uint64_t MilestonesMs[]    = {1000, 5000, 30000, 120000, 600000};
+inline constexpr uint32_t MilestoneCount    = sizeof(MilestonesMs) / sizeof(MilestonesMs[0]);
+
+// WAIT_REG_MEM function field: the test is "(value & mask) <op> ref".
+inline const char* CompareOperator(uint32_t func) {
+	switch (func) {
+		case 0: return "always";
+		case 1: return "<";
+		case 2: return "<=";
+		case 3: return "==";
+		case 4: return "!=";
+		case 5: return ">=";
+		case 6: return ">";
+		default: return "?";
+	}
+}
+
+// One WAIT_REG_MEM packet as the command processor evaluates it.
+struct Wait {
+	uint64_t addr          = 0; // full 64-bit guest address of the watched value
+	uint64_t ref           = 0;
+	uint64_t mask          = 0;
+	uint32_t func          = 0;
+	uint32_t size_bytes    = 4; // 4 for WAIT_REG_MEM, 8 for WAIT_REG_MEM_64
+	uint32_t poll          = 0; // the packet's poll interval field (the emulator does not use it)
+	uint32_t wait_op       = 0;
+	uint64_t submit_id     = 0;
+	bool     async_compute = false;
+};
+
+namespace Detail {
+
+inline std::atomic<uint32_t> g_long_waits {0};
+inline std::atomic<uint32_t> g_change_lines {0};
+inline std::atomic<bool>     g_budget_told {false};
+
+inline void ResetForTest() {
+	g_long_waits.store(0);
+	g_change_lines.store(0);
+	g_budget_told.store(false);
+}
+
+// The same packet re-evaluated: the processor re-runs a suspended WAIT_REG_MEM until it passes,
+// and a later submission running the same packet is a new wait.
+inline bool SameWait(const Wait& a, const Wait& b) {
+	return a.addr == b.addr && a.ref == b.ref && a.mask == b.mask && a.func == b.func &&
+	       a.size_bytes == b.size_bytes && a.submit_id == b.submit_id;
+}
+
+inline int HexDigits(uint32_t size_bytes) {
+	return size_bytes == 8 ? 16 : 8;
+}
+
+// The queue whose processor runs `submit_id`, from FrameTrace's per-queue state; -1 if unknown
+// (FrameTrace off, or the submission not found).
+inline int QueueOfSubmission(uint64_t submit_id) {
+	if (submit_id == 0 || !FrameProgress::Enabled()) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < FrameProgress::MaxQueues; i++) {
+		if (FrameProgress::Detail::g_queues[i].current_submit_id.load(std::memory_order_relaxed) ==
+		    submit_id) {
+			return static_cast<int>(i);
+		}
+	}
+	return -1;
+}
+
+} // namespace Detail
+
+// Per command processor. Used only by the thread running that processor.
+class Tracker {
+public:
+	// Called on every WAIT_REG_MEM evaluation with the value the processor read and its verdict.
+	void Observe(const Wait& wait, uint64_t value, bool satisfied) {
+		if (satisfied && !m_active) {
+			return; // the common case: a wait that never had to wait
+		}
+		if (!StallProbe::Enabled()) {
+			m_active = false;
+			return;
+		}
+		ObserveAt(wait, value, satisfied, StallProbe::NowUs());
+	}
+
+	// Same, with the clock supplied (tests).
+	void ObserveAt(const Wait& wait, uint64_t value, bool satisfied, uint64_t now_us) {
+		if (m_active && !Detail::SameWait(wait, m_wait)) {
+			// The processor is evaluating a different packet without this one having passed
+			// here (for example its submission was dropped).
+			End("superseded", m_last_value, now_us);
+		}
+		if (!m_active) {
+			if (satisfied) {
+				return;
+			}
+			m_active      = true;
+			m_wait        = wait;
+			m_start_us    = now_us;
+			m_first_value = value;
+			m_last_value  = value;
+			m_evaluations = 1;
+			m_changes     = 0;
+			m_long        = false;
+			m_id          = 0;
+			m_milestone   = 0;
+			return;
+		}
+
+		m_evaluations++;
+		const uint64_t waited_ms = (now_us - m_start_us) / 1000;
+		if (value != m_last_value) {
+			m_changes++;
+			if (m_id != 0 && m_changes <= MaxChangesPerWait &&
+			    Detail::g_change_lines.fetch_add(1, std::memory_order_relaxed) < MaxChangeLines) {
+				const int w = Detail::HexDigits(m_wait.size_bytes);
+				LOGF("WaitRegMemProbe: wait=%" PRIu32 " value_change waited_ms=%" PRIu64
+				     " evaluations=%" PRIu64 " value=0x%0*" PRIx64 " masked=0x%0*" PRIx64
+				     " previous=0x%0*" PRIx64 "\n",
+				     m_id, waited_ms, m_evaluations, w, value, w, value & m_wait.mask, w,
+				     m_last_value);
+			}
+			m_last_value = value;
+		}
+		if (satisfied) {
+			End("satisfied", value, now_us);
+			return;
+		}
+		if (!m_long && now_us - m_start_us >= LongWaitUs) {
+			m_long = true;
+			StallProbe::PublishLongWaitAddress(m_wait.addr);
+			const uint32_t n = Detail::g_long_waits.fetch_add(1, std::memory_order_relaxed) + 1;
+			if (n <= MaxLongWaits) {
+				m_id = n;
+				LogBegin(value, waited_ms);
+			} else if (!Detail::g_budget_told.exchange(true)) {
+				LOGF("WaitRegMemProbe: %" PRIu32 " long waits logged; later ones are not\n",
+				     MaxLongWaits);
+			}
+		}
+		if (m_id != 0 && m_milestone < MilestoneCount && waited_ms >= MilestonesMs[m_milestone]) {
+			while (m_milestone < MilestoneCount && waited_ms >= MilestonesMs[m_milestone]) {
+				m_milestone++; // one line even if a slow poll passed several milestones
+			}
+			const int w = Detail::HexDigits(m_wait.size_bytes);
+			char      now[32];
+			StallProbe::LocalTime(now, sizeof(now));
+			LOGF("WaitRegMemProbe: wait=%" PRIu32 " still_waiting local_time=%s waited_ms=%" PRIu64
+			     " evaluations=%" PRIu64 " changes=%" PRIu32 " value=0x%0*" PRIx64
+			     " masked=0x%0*" PRIx64 " condition=(value&mask)%sref ref=0x%0*" PRIx64 "\n",
+			     m_id, now, waited_ms, m_evaluations, m_changes, w, value, w, value & m_wait.mask,
+			     CompareOperator(m_wait.func), w, m_wait.ref);
+		}
+	}
+
+	[[nodiscard]] bool Active() const { return m_active; }
+
+private:
+	void LogBegin(uint64_t value, uint64_t waited_ms) const {
+		const int w = Detail::HexDigits(m_wait.size_bytes);
+		char      now[32];
+		StallProbe::LocalTime(now, sizeof(now));
+		LOGF("WaitRegMemProbe: wait=%" PRIu32 " begin local_time=%s queue=%d submit=%" PRIu64
+		     " async_compute=%d addr=0x%016" PRIx64 " bits=%" PRIu32
+		     " condition=(value&mask)%sref func=%" PRIu32 " ref=0x%0*" PRIx64 " mask=0x%0*" PRIx64
+		     " value=0x%0*" PRIx64 " masked=0x%0*" PRIx64 " first_value=0x%0*" PRIx64
+		     " poll=%" PRIu32 " wait_op=%" PRIu32 " waited_ms=%" PRIu64 " evaluations=%" PRIu64
+		     "\n",
+		     m_id, now, Detail::QueueOfSubmission(m_wait.submit_id), m_wait.submit_id,
+		     m_wait.async_compute ? 1 : 0, m_wait.addr, m_wait.size_bytes * 8,
+		     CompareOperator(m_wait.func), m_wait.func, w, m_wait.ref, w, m_wait.mask, w, value, w,
+		     value & m_wait.mask, w, m_first_value, m_wait.poll, m_wait.wait_op, waited_ms,
+		     m_evaluations);
+	}
+
+	void End(const char* result, uint64_t final_value, uint64_t now_us) {
+		if (m_id != 0) {
+			const int w = Detail::HexDigits(m_wait.size_bytes);
+			char      now[32];
+			StallProbe::LocalTime(now, sizeof(now));
+			LOGF("WaitRegMemProbe: wait=%" PRIu32 " end result=%s local_time=%s waited_ms=%" PRIu64
+			     " evaluations=%" PRIu64 " changes=%" PRIu32 " first_value=0x%0*" PRIx64
+			     " final_value=0x%0*" PRIx64 "\n",
+			     m_id, result, now, (now_us - m_start_us) / 1000, m_evaluations, m_changes, w,
+			     m_first_value, w, final_value);
+		}
+		m_active = false;
+		m_long   = false;
+		m_id     = 0;
+	}
+
+	bool     m_active      = false;
+	Wait     m_wait        = {};
+	uint64_t m_start_us    = 0;
+	uint64_t m_first_value = 0;
+	uint64_t m_last_value  = 0;
+	uint64_t m_evaluations = 0;
+	uint32_t m_changes     = 0;
+	bool     m_long        = false;
+	uint32_t m_id          = 0; // 1-based number in the log; 0 = not logged
+	uint32_t m_milestone   = 0; // next entry of MilestonesMs to report
+};
+
+} // namespace Libs::Graphics::WaitRegMemProbe
+
+#endif // GRAPHICS_GUEST_GPU_COMMAND_PROCESSOR_WAIT_REG_MEM_PROBE_H_
