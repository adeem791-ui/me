diff --git a/src/kernel/mainThreadSampler.cpp b/src/kernel/mainThreadSampler.cpp
new file mode 100644
index 00000000..9c7d997a
--- /dev/null
+++ b/src/kernel/mainThreadSampler.cpp
@@ -0,0 +1,804 @@
+#include "kernel/mainThreadSampler.h"
+
+#include "common/common.h"
+#include "common/logging/log.h"
+#include "common/singleton.h"
+#include "kernel/stallProbe.h"
+#include "loader/runtimeLinker.h"
+
+#include <chrono>
+#include <cinttypes>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace Libs::MainThreadSampler {
+
+namespace {
+
+using namespace Detail;
+
+const char* JoinName() {
+	const char* value = std::getenv("KYTY_STALL_PROBE_JOIN");
+	return (value != nullptr && value[0] != '\0') ? value : "GameState";
+}
+
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+
+bool CodeBytesEnabled() {
+	const char* value = std::getenv("KYTY_STALL_PROBE_CODE");
+	return value == nullptr || std::strcmp(value, "0") != 0;
+}
+
+constexpr const char* RegNames[16] = {"rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi",
+                                      "r8",  "r9",  "r10", "r11", "r12", "r13", "r14", "r15"};
+
+// One sample, filled while the main thread is suspended. Fixed size: nothing is allocated then.
+struct RawSample {
+	uint64_t t_us            = 0; // since the campaign started
+	bool     ok              = false;
+	uint32_t error           = 0;
+	uint64_t rip             = 0;
+	uint64_t rflags          = 0;
+	uint64_t gpr[16]         = {}; // RegNames order
+	uint64_t target[16]      = {}; // the 8 bytes each register points at, where readable
+	uint32_t target_ok       = 0;  // bit i: target[i] valid
+	uint32_t stack_bytes     = 0;
+	uint64_t pause_ns        = 0; // SuspendThread call to ResumeThread return
+	uint32_t prior_suspend   = 0; // SuspendThread's return: > 0 = already suspended by someone else
+	uint32_t resume_attempts = 0;
+	uint8_t  stack[StackBytes] = {};
+};
+
+bool Readable(uint64_t addr) {
+	MEMORY_BASIC_INFORMATION info {};
+	if (addr < 0x10000 || VirtualQuery(reinterpret_cast<LPCVOID>(addr), &info, sizeof(info)) == 0) {
+		return false;
+	}
+	// Guard pages are skipped: touching one, even from a system call, clears its guard state
+	// and would break the owning thread's stack growth.
+	constexpr DWORD READABLE = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+	                           PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+	return info.State == MEM_COMMIT && (info.Protect & READABLE) != 0 &&
+	       (info.Protect & (PAGE_GUARD | PAGE_NOACCESS)) == 0;
+}
+
+// Reads `size` bytes within one page. A system call copy: it cannot fault, and it does not go
+// through the emulator's access-tracking handlers.
+bool ReadInPage(uint64_t addr, void* out, size_t size) {
+	SIZE_T done = 0;
+	return Readable(addr) &&
+	       ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<LPCVOID>(addr), out, size,
+	                         &done) != 0 &&
+	       done == size;
+}
+
+// Reads up to `size` bytes, stopping at the first page that cannot be read. Returns bytes read.
+size_t ReadUpTo(uint64_t addr, uint8_t* out, size_t size) {
+	size_t total = 0;
+	while (total < size) {
+		const uint64_t at      = addr + total;
+		const size_t   in_page = 4096 - static_cast<size_t>(at & 4095u);
+		const size_t   chunk   = std::min(in_page, size - total);
+		if (!ReadInPage(at, out + total, chunk)) {
+			break;
+		}
+		total += chunk;
+	}
+	return total;
+}
+
+bool SafeRead(uint64_t addr, void* out, size_t size) {
+	return ReadUpTo(addr, static_cast<uint8_t*>(out), size) == size;
+}
+
+uint64_t FileTimeValue(const FILETIME& t) {
+	return (static_cast<uint64_t>(t.dwHighDateTime) << 32u) | t.dwLowDateTime;
+}
+
+// Kernel + user time in 100 ns units; UINT64_MAX if unavailable.
+uint64_t ThreadCpu(HANDLE thread) {
+	FILETIME creation {};
+	FILETIME exit {};
+	FILETIME kernel {};
+	FILETIME user {};
+	if (GetThreadTimes(thread, &creation, &exit, &kernel, &user) == 0) {
+		return UINT64_MAX;
+	}
+	return FileTimeValue(kernel) + FileTimeValue(user);
+}
+
+// Names addresses. Built per burst, after the main thread is running again.
+class Resolver {
+public:
+	explicit Resolver(const FunctionList& hle): m_hle(hle) {
+		auto* rt = Common::Singleton<Loader::RuntimeLinker>::Instance();
+		for (const auto& p: rt->SnapshotProgramRanges()) {
+			m_guests.push_back({p.file_name, p.base_vaddr, p.base_vaddr + p.base_size_aligned,
+			                    p.base_vaddr + p.mapped_size});
+		}
+		GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+		                       GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		                   reinterpret_cast<LPCWSTR>(&NoteJoin), &m_emulator);
+	}
+
+	[[nodiscard]] const std::vector<GuestRange>& Guests() const { return m_guests; }
+
+	struct Location {
+		Kind        kind = Kind::Unknown;
+		std::string text;
+		std::string hle; // the HLE function an emulator address is near, if any
+	};
+
+	Location Describe(uint64_t addr) {
+		Location loc;
+		char     buf[256];
+		bool     stub = false;
+		if (const auto* guest = FindGuest(m_guests, addr, &stub); guest != nullptr) {
+			loc.kind = stub ? Kind::GuestStub : Kind::Guest;
+			std::snprintf(buf, sizeof(buf), "%s %s+0x%" PRIx64, KindName(loc.kind),
+			              guest->name.c_str(), addr - guest->base);
+			loc.text = buf;
+			return loc;
+		}
+		if (const auto* module = ModuleOf(addr); module != nullptr) {
+			const auto rva =
+			    static_cast<uint32_t>(addr - reinterpret_cast<uint64_t>(module->handle));
+			if (module->emulator) {
+				loc.kind = Kind::Emulator;
+				std::snprintf(buf, sizeof(buf), "emulator %s+0x%" PRIx32, module->name.c_str(),
+				              rva);
+				loc.text = buf;
+				if (const auto* fn = NearestFunction(m_hle, addr);
+				    fn != nullptr && addr - fn->first < 0x4000) {
+					std::snprintf(buf, sizeof(buf), " near_hle=%.96s+0x%" PRIx64,
+					              fn->second.c_str(), addr - fn->first);
+					loc.text += buf;
+					loc.hle = fn->second;
+				}
+				return loc;
+			}
+			uint32_t    export_rva = 0;
+			const char* name       = NearestExport(reinterpret_cast<const uint8_t*>(module->handle),
+			                                       module->size, rva, &export_rva);
+			loc.kind               = ClassifyHost(false, module->name.c_str(), name);
+			if (name != nullptr) {
+				std::snprintf(buf, sizeof(buf), "%s %s!%.96s+0x%" PRIx32, KindName(loc.kind),
+				              module->name.c_str(), name, rva - export_rva);
+			} else {
+				std::snprintf(buf, sizeof(buf), "%s %s+0x%" PRIx32, KindName(loc.kind),
+				              module->name.c_str(), rva);
+			}
+			loc.text = buf;
+			return loc;
+		}
+		MEMORY_BASIC_INFORMATION info {};
+		loc.kind = Kind::Unknown;
+		if (VirtualQuery(reinterpret_cast<LPCVOID>(addr), &info, sizeof(info)) == 0 ||
+		    info.State != MEM_COMMIT) {
+			loc.text = "unknown unmapped";
+		} else {
+			constexpr DWORD EXEC =
+			    PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+			std::snprintf(buf, sizeof(buf), "unknown %s alloc=0x%016" PRIx64 "+0x%" PRIx64,
+			              (info.Protect & EXEC) != 0 ? "anon_exec" : "not_executable",
+			              reinterpret_cast<uint64_t>(info.AllocationBase),
+			              addr - reinterpret_cast<uint64_t>(info.AllocationBase));
+			loc.text = buf;
+		}
+		return loc;
+	}
+
+	// What a call went to: an HLE function by name when it is exactly one, else a location.
+	std::string DescribeCallee(uint64_t dest) {
+		if (dest == 0) {
+			return "?";
+		}
+		if (FindGuest(m_guests, dest, nullptr) == nullptr) {
+			if (const auto* fn = NearestFunction(m_hle, dest); fn != nullptr && fn->first == dest) {
+				return "HLE " + fn->second;
+			}
+		}
+		return Describe(dest).text;
+	}
+
+private:
+	struct Module {
+		HMODULE     handle = nullptr;
+		std::string name;
+		bool        emulator = false;
+		uint32_t    size     = 0;
+	};
+
+	const Module* ModuleOf(uint64_t addr) {
+		HMODULE handle = nullptr;
+		if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+		                           GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		                       reinterpret_cast<LPCWSTR>(addr), &handle) == 0 ||
+		    handle == nullptr) {
+			return nullptr;
+		}
+		for (const auto& module: m_modules) {
+			if (module.handle == handle) {
+				return &module;
+			}
+		}
+		Module module;
+		module.handle                 = handle;
+		module.emulator               = handle == m_emulator;
+		module.size                   = PeImageSize(reinterpret_cast<const uint8_t*>(handle), 4096);
+		wchar_t        path[MAX_PATH] = {};
+		const DWORD    length         = GetModuleFileNameW(handle, path, MAX_PATH);
+		const wchar_t* base           = path;
+		for (DWORD i = 0; i < length; i++) {
+			if (path[i] == L'\\' || path[i] == L'/') {
+				base = path + i + 1;
+			}
+		}
+		char name[MAX_PATH] = {};
+		if (WideCharToMultiByte(CP_UTF8, 0, base, -1, name, static_cast<int>(sizeof(name)), nullptr,
+		                        nullptr) == 0) {
+			std::snprintf(name, sizeof(name), "module@0x%016" PRIx64,
+			              reinterpret_cast<uint64_t>(handle));
+		}
+		module.name = name;
+		m_modules.push_back(module);
+		return &m_modules.back();
+	}
+
+	const FunctionList&     m_hle;
+	std::vector<GuestRange> m_guests;
+	std::vector<Module>     m_modules;
+	HMODULE                 m_emulator = nullptr;
+};
+
+#endif // KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+
+class Sampler final {
+public:
+	Sampler() = default;
+	~Sampler() {
+		m_queue.Stop();
+		if (m_thread.joinable()) {
+			m_thread.join();
+		}
+	}
+	Sampler(const Sampler&)            = delete;
+	Sampler& operator=(const Sampler&) = delete;
+
+	static Sampler& Instance() {
+		static Sampler sampler;
+		return sampler;
+	}
+
+	void Submit(const Request& request) {
+		const auto result = m_queue.Submit(request, [this] {
+			m_thread = std::thread(
+			    [this] { WorkerLoop(m_queue, [this](const Request& r) { RunCampaign(r); }); });
+		});
+		if (!result.first_refusal) {
+			return;
+		}
+		if (result.outcome == CampaignQueue::Outcome::Disabled) {
+			LOGF("MainSampler: join of %s at %s not sampled: sampling stopped earlier in this run "
+			     "after a ResumeThread failure\n",
+			     request.joined, request.local_time);
+		} else if (result.outcome == CampaignQueue::Outcome::CapReached) {
+			LOGF("MainSampler: join of %s at %s not sampled: %" PRIu32
+			     " campaigns per run already used\n",
+			     request.joined, request.local_time, MaxCampaigns);
+		}
+	}
+
+private:
+	// Waits until `when`. False if shutdown, a newer join or a disable interrupts.
+	bool WaitUntil(std::chrono::steady_clock::time_point when) { return m_queue.WaitUntil(when); }
+
+	[[nodiscard]] const char* Interruption() { return m_queue.Interruption(); }
+
+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+	void RunCampaign(const Request& r) {
+		HANDLE thread =
+		    OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE,
+		               static_cast<DWORD>(r.main_host_tid));
+		if (thread == nullptr) {
+			LOGF("MainSampler: campaign=%" PRIu32 " cannot open the main thread (host_tid=%" PRIu64
+			     ", error %lu); not sampled\n",
+			     r.campaign, r.main_host_tid, GetLastError());
+			return;
+		}
+		std::string schedule;
+		for (uint32_t i = 0; i < BurstCount; i++) {
+			schedule += (i == 0 ? "" : ",") + std::to_string(BurstOffsetsS[i]);
+		}
+		LOGF("MainSampler: campaign=%" PRIu32 " start local_time=%s trigger=join:%s joiner_id=%d "
+		     "target=main_thread guest_id=%d host_tid=%" PRIu64 " bursts_at_s=%s "
+		     "samples_per_burst=%" PRIu32 " interval_ms=%" PRIu32 " stack_bytes=%" PRIu32 "\n",
+		     r.campaign, r.local_time, r.joined, r.joiner_id, r.main_id, r.main_host_tid,
+		     schedule.c_str(), SamplesPerBurst, SampleIntervalMs, StackBytes);
+
+		if (m_samples.empty()) {
+			m_samples.resize(SamplesPerBurst);
+		}
+		LARGE_INTEGER frequency {};
+		QueryPerformanceFrequency(&frequency);
+		m_qpc_frequency = frequency.QuadPart > 0 ? static_cast<uint64_t>(frequency.QuadPart) : 1;
+		uint64_t    campaign_samples  = 0;
+		uint64_t    campaign_pause_ns = 0;
+		uint64_t    campaign_max_ns   = 0;
+		const auto  start             = std::chrono::steady_clock::now();
+		uint64_t    prev_cpu          = ThreadCpu(thread);
+		auto        prev_at           = start;
+		std::string prev_top;
+		std::string prev_guest_top;
+		const char* end = "schedule_done";
+		for (uint32_t b = 0; b < BurstCount; b++) {
+			if (!WaitUntil(start + std::chrono::seconds(BurstOffsetsS[b]))) {
+				end = Interruption();
+				break;
+			}
+			ULONG64        cycles_begin = 0;
+			ULONG64        cycles_end   = 0;
+			const bool     cycles_ok    = QueryThreadCycleTime(thread, &cycles_begin) != 0;
+			const auto     burst_begin  = std::chrono::steady_clock::now();
+			const uint32_t ok           = TakeBurst(thread, start);
+			const auto     burst_end    = std::chrono::steady_clock::now();
+			if (m_resume_failure.failed) {
+				// The main thread may still be suspended, possibly holding a lock the naming code
+				// or the logger needs. Sampling is disabled and any queued campaign dropped first,
+				// under the queue's lock; only then is the one line logged. Nothing samples again.
+				HandleResumeExhausted(m_queue, [&](bool dropped) {
+					LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 " sample=%" PRIu32
+					     " ResumeThread FAILED %" PRIu32 " times (last error %" PRIu32
+					     "); the main thread may still be suspended; sampling stopped for this run"
+					     " (queued_campaign_dropped=%d)\n",
+					     r.campaign, b + 1, m_resume_failure.sample, m_resume_failure.attempts,
+					     m_resume_failure.error, dropped ? 1 : 0);
+				});
+				end = "resume_failed";
+				break;
+			}
+			const bool     cycles_ok2 = QueryThreadCycleTime(thread, &cycles_end) != 0;
+			const uint64_t cpu        = ThreadCpu(thread);
+
+			BurstStats stats;
+			stats.samples = m_taken;
+			for (uint32_t i = 0; i < m_taken; i++) {
+				campaign_pause_ns += m_samples[i].pause_ns;
+				campaign_max_ns = std::max(campaign_max_ns, m_samples[i].pause_ns);
+			}
+			campaign_samples += m_taken;
+			const auto window_us =
+			    std::chrono::duration_cast<std::chrono::microseconds>(burst_end - prev_at).count();
+			if (cpu != UINT64_MAX && prev_cpu != UINT64_MAX && window_us > 0) {
+				stats.cpu_pct = static_cast<double>(cpu - prev_cpu) / 10.0 * 100.0 /
+				                static_cast<double>(window_us);
+			}
+			const auto burst_us =
+			    std::chrono::duration_cast<std::chrono::microseconds>(burst_end - burst_begin)
+			        .count();
+			const double cycles_per_us =
+			    (cycles_ok && cycles_ok2 && burst_us > 0)
+			        ? static_cast<double>(cycles_end - cycles_begin) / static_cast<double>(burst_us)
+			        : -1.0;
+			Report(r, b, stats, cycles_per_us, static_cast<uint64_t>(window_us) / 1000,
+			       static_cast<uint64_t>(burst_us), &prev_top, &prev_guest_top);
+			prev_cpu = cpu;
+			prev_at  = burst_end;
+			if (ok == 0 && m_samples[0].error == ERROR_INVALID_HANDLE) {
+				end = "thread_gone";
+				break;
+			}
+			if (ok == 0) {
+				DWORD exit_code = 0;
+				if (GetExitCodeThread(thread, &exit_code) != 0 && exit_code != STILL_ACTIVE) {
+					end = "thread_exited";
+					break;
+				}
+			}
+		}
+		CloseHandle(thread);
+		char now[32];
+		StallProbe::LocalTime(now, sizeof(now));
+		LOGF("MainSampler: campaign=%" PRIu32 " end reason=%s local_time=%s samples=%" PRIu64
+		     " main_thread_paused_us_total=%.1f pause_us_max=%.1f\n",
+		     r.campaign, end, now, campaign_samples,
+		     static_cast<double>(campaign_pause_ns) / 1000.0,
+		     static_cast<double>(campaign_max_ns) / 1000.0);
+	}
+
+	// Takes one burst into m_samples. Between SuspendThread and ResumeThread only system calls
+	// run: no allocation, no lock, no logging. Every ResumeThread is checked and retried; if it
+	// still fails, the burst stops at once and m_resume_failure says so. Returns how many samples
+	// succeeded; m_taken is how many were attempted.
+	uint32_t TakeBurst(HANDLE thread, std::chrono::steady_clock::time_point start) {
+		uint32_t ok      = 0;
+		m_taken          = 0;
+		m_resume_failure = {};
+		for (uint32_t i = 0; i < SamplesPerBurst; i++) {
+			if (i != 0) {
+				std::this_thread::sleep_for(std::chrono::milliseconds(SampleIntervalMs));
+			}
+			RawSample& s = m_samples[i];
+			s.t_us  = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                               std::chrono::steady_clock::now() - start)
+			                                    .count());
+			s.ok    = false;
+			s.error = 0;
+			s.target_ok       = 0;
+			s.stack_bytes     = 0;
+			s.pause_ns        = 0;
+			s.prior_suspend   = 0;
+			s.resume_attempts = 0;
+			m_taken           = i + 1;
+
+			LARGE_INTEGER paused_at {};
+			QueryPerformanceCounter(&paused_at);
+			const DWORD prior = SuspendThread(thread);
+			if (prior == static_cast<DWORD>(-1)) {
+				s.error = GetLastError();
+				continue;
+			}
+			s.prior_suspend = prior;
+			CONTEXT context {};
+			context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+			if (GetThreadContext(thread, &context) != 0) {
+				s.ok                    = true;
+				s.rip                   = context.Rip;
+				s.rflags                = context.EFlags;
+				const uint64_t regs[16] = {context.Rax, context.Rcx, context.Rdx, context.Rbx,
+				                           context.Rsp, context.Rbp, context.Rsi, context.Rdi,
+				                           context.R8,  context.R9,  context.R10, context.R11,
+				                           context.R12, context.R13, context.R14, context.R15};
+				for (uint32_t r = 0; r < 16; r++) {
+					s.gpr[r] = regs[r];
+					if (r != 4 && SafeRead(regs[r], &s.target[r], sizeof(uint64_t))) {
+						s.target_ok |= 1u << r;
+					}
+				}
+				s.stack_bytes = static_cast<uint32_t>(ReadUpTo(context.Rsp, s.stack, StackBytes));
+			} else {
+				s.error = GetLastError();
+			}
+			const ResumeOutcome resume = ResumeWithRetry(
+			    [thread](uint32_t* error) -> uint32_t {
+				    const DWORD previous = ResumeThread(thread);
+				    if (previous == static_cast<DWORD>(-1)) {
+					    *error = GetLastError();
+					    return UINT32_MAX;
+				    }
+				    return previous;
+			    },
+			    ResumeAttempts);
+			LARGE_INTEGER resumed_at {};
+			QueryPerformanceCounter(&resumed_at);
+			s.pause_ns = static_cast<uint64_t>(resumed_at.QuadPart - paused_at.QuadPart) *
+			             1000000000ull / m_qpc_frequency;
+			s.resume_attempts = resume.attempts;
+			if (!resume.resumed) {
+				s.ok             = false;
+				m_resume_failure = {true, i, resume.attempts, resume.error};
+				break;
+			}
+			ok += s.ok ? 1 : 0;
+		}
+		return ok;
+	}
+
+	// Names, tallies and logs one burst. The main thread is running again.
+	void Report(const Request& r, uint32_t b, BurstStats& stats, double cycles_per_us,
+	            uint64_t cpu_window_ms, uint64_t burst_us, std::string* prev_top,
+	            std::string* prev_guest_top) {
+		if (m_hle.empty()) {
+			// Once: the HLE table is complete before any guest code runs.
+			m_hle = Common::Singleton<Loader::RuntimeLinker>::Instance()->SnapshotHleFunctions();
+			std::sort(m_hle.begin(), m_hle.end());
+		}
+		Resolver   resolver(m_hle);
+		const auto read = [](uint64_t addr, void* out, size_t size) {
+			return SafeRead(addr, out, size);
+		};
+
+		std::vector<Resolver::Location> locations(m_taken);
+		std::vector<std::string>        location_keys(m_taken);
+		std::vector<std::string>        entry_keys;
+		std::vector<std::string>        caller_text(m_taken);
+		std::vector<uint64_t>           rips;
+		for (uint32_t i = 0; i < m_taken; i++) {
+			const RawSample& s = m_samples[i];
+			if (!s.ok) {
+				stats.by_kind[static_cast<uint32_t>(Kind::Failed)]++;
+				continue;
+			}
+			locations[i]     = resolver.Describe(s.rip);
+			location_keys[i] = locations[i].text;
+			stats.by_kind[static_cast<uint32_t>(locations[i].kind)]++;
+			if (std::find(rips.begin(), rips.end(), s.rip) == rips.end()) {
+				rips.push_back(s.rip);
+			}
+
+			uint64_t       rets[MaxCallers] = {};
+			CallSite       sites[MaxCallers];
+			const uint32_t callers = ScanGuestReturnAddresses(
+			    s.stack, s.stack_bytes, resolver.Guests(), read, rets, sites, MaxCallers);
+			std::string first_callee;
+			for (uint32_t c = 0; c < callers; c++) {
+				const std::string callee =
+				    sites[c].form == CallForm::Indirect
+				        ? std::string("(indirect)")
+				        : resolver.DescribeCallee(ResolveCallee(sites[c], resolver.Guests(), read));
+				if (c == 0) {
+					first_callee = callee;
+				}
+				caller_text[i] +=
+				    (c == 0 ? "" : "; ") + resolver.Describe(rets[c]).text + " -> " + callee;
+			}
+			const Kind kind = locations[i].kind;
+			if (kind == Kind::Emulator || kind == Kind::OsWait || kind == Kind::OsYield ||
+			    kind == Kind::HostOther) {
+				stats.host_samples++;
+				// The emulator entry point this host sample is under: the HLE function the guest
+				// called, read from the guest's call site, else the nearest HLE function.
+				entry_keys.push_back(first_callee.rfind("HLE ", 0) == 0 ? first_callee
+				                     : !locations[i].hle.empty()        ? "near " + locations[i].hle
+				                                                        : locations[i].text);
+			}
+		}
+		stats.distinct_rips = static_cast<uint32_t>(rips.size());
+
+		std::string    top[TopLocations];
+		uint32_t       top_counts[TopLocations] = {};
+		const uint32_t top_n = TopKeys(location_keys, top, top_counts, TopLocations);
+		std::string    entry_top[1];
+		uint32_t       entry_count[1] = {};
+		if (TopKeys(entry_keys, entry_top, entry_count, 1) == 1) {
+			stats.top_emulator_entry = entry_count[0];
+		}
+
+		// The commonest guest location (it need not be the commonest location overall), and the
+		// guest span within its module.
+		std::vector<std::string> guest_keys(m_taken);
+		for (uint32_t i = 0; i < m_taken; i++) {
+			if (m_samples[i].ok && locations[i].kind == Kind::Guest) {
+				guest_keys[i] = location_keys[i];
+			}
+		}
+		std::string       guest_top[1];
+		uint32_t          guest_top_count[1] = {};
+		const GuestRange* busiest_guest      = nullptr;
+		uint32_t          busiest_sample     = m_taken;
+		if (TopKeys(guest_keys, guest_top, guest_top_count, 1) == 1) {
+			for (uint32_t i = 0; i < m_taken; i++) {
+				if (guest_keys[i] == guest_top[0]) {
+					busiest_guest  = FindGuest(resolver.Guests(), m_samples[i].rip, nullptr);
+					busiest_sample = i;
+					break;
+				}
+			}
+		}
+		if (busiest_guest != nullptr) {
+			uint64_t lo = UINT64_MAX;
+			uint64_t hi = 0;
+			for (uint32_t i = 0; i < m_taken; i++) {
+				if (m_samples[i].ok && locations[i].kind == Kind::Guest &&
+				    FindGuest(resolver.Guests(), m_samples[i].rip, nullptr) == busiest_guest) {
+					lo = std::min(lo, m_samples[i].rip);
+					hi = std::max(hi, m_samples[i].rip);
+				}
+			}
+			stats.guest_span = hi - lo;
+		} else {
+			stats.guest_span = UINT64_MAX;
+		}
+
+		std::string top_text;
+		for (uint32_t t = 0; t < top_n; t++) {
+			top_text += (t == 0 ? "" : "; ") + top[t] + " x" + std::to_string(top_counts[t]);
+		}
+		const std::string span_text =
+		    stats.guest_span == UINT64_MAX ? "n/a" : "0x" + Hex(stats.guest_span);
+		// The probe's own impact: how long the main thread was held in this burst.
+		uint64_t pauses[SamplesPerBurst] = {};
+		uint32_t paused                  = 0;
+		uint32_t already_suspended       = 0;
+		uint32_t resume_retries          = 0;
+		for (uint32_t i = 0; i < m_taken; i++) {
+			if (m_samples[i].pause_ns != 0) {
+				pauses[paused++] = m_samples[i].pause_ns;
+			}
+			already_suspended += m_samples[i].prior_suspend != 0 ? 1 : 0;
+			resume_retries +=
+			    m_samples[i].resume_attempts > 1 ? m_samples[i].resume_attempts - 1 : 0;
+		}
+		const PauseStats pause = SummarizePauses(pauses, paused);
+		const auto       us    = [](uint64_t ns) { return static_cast<double>(ns) / 1000.0; };
+		const double     pause_pct =
+            burst_us > 0 ? us(pause.total_ns) * 100.0 / static_cast<double>(burst_us) : 0.0;
+		char now[32];
+		StallProbe::LocalTime(now, sizeof(now));
+		const auto c = [&](Kind k) { return Count(stats, k); };
+		LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 "/%" PRIu32 " t=+%" PRIu32
+		     "s local_time=%s verdict=%s samples=%" PRIu32 " guest=%" PRIu32 " guest_stub=%" PRIu32
+		     " emulator=%" PRIu32 " os_wait=%" PRIu32 " os_yield=%" PRIu32 " host_other=%" PRIu32
+		     " unknown=%" PRIu32 " failed=%" PRIu32 " distinct_rips=%" PRIu32
+		     " guest_span=%s cpu_pct=%.1f cpu_window_ms=%" PRIu64
+		     " burst_cycles_per_us=%.0f burst_ms=%.1f pauses=%" PRIu32 " pause_us_min=%.1f"
+		     " pause_us_median=%.1f pause_us_max=%.1f pause_us_total=%.1f pause_pct_of_burst=%.3f"
+		     " already_suspended=%" PRIu32 " resume_retries=%" PRIu32
+		     " emulator_entry=[%s x%" PRIu32 "] top=[%s]\n",
+		     r.campaign, b + 1, BurstCount, BurstOffsetsS[b], now, Verdict(stats), stats.samples,
+		     c(Kind::Guest), c(Kind::GuestStub), c(Kind::Emulator), c(Kind::OsWait),
+		     c(Kind::OsYield), c(Kind::HostOther), c(Kind::Unknown), c(Kind::Failed),
+		     stats.distinct_rips, span_text.c_str(), stats.cpu_pct, cpu_window_ms, cycles_per_us,
+		     static_cast<double>(burst_us) / 1000.0, pause.count, us(pause.min_ns),
+		     us(pause.median_ns), us(pause.max_ns), us(pause.total_ns), pause_pct,
+		     already_suspended, resume_retries, entry_count[0] != 0 ? entry_top[0].c_str() : "none",
+		     entry_count[0], top_text.c_str());
+
+		for (uint32_t i = 0, printed = 0; i < m_taken && printed < PrintedSamplesPerBurst; i++) {
+			const RawSample& s = m_samples[i];
+			printed++;
+			if (!s.ok) {
+				LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 " sample=%" PRIu32
+				     " t=+%.3fs failed error=%" PRIu32 "\n",
+				     r.campaign, b + 1, i, static_cast<double>(s.t_us) / 1e6, s.error);
+				continue;
+			}
+			LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 " sample=%" PRIu32
+			     " t=+%.3fs paused_us=%.1f rip=0x%016" PRIx64 " %s rsp=0x%016" PRIx64
+			     " callers=[%s]\n",
+			     r.campaign, b + 1, i, static_cast<double>(s.t_us) / 1e6, us(s.pause_ns), s.rip,
+			     locations[i].text.c_str(), s.gpr[4],
+			     caller_text[i].empty() ? "none found" : caller_text[i].c_str());
+		}
+
+		// The code around the busiest guest address, when that changes.
+		if (busiest_sample < m_taken && guest_top[0] != *prev_guest_top) {
+			*prev_guest_top = guest_top[0];
+			if (CodeBytesEnabled()) {
+				uint8_t        code[CodeBytesBefore + CodeBytesAfter] = {};
+				const uint64_t from = m_samples[busiest_sample].rip - CodeBytesBefore;
+				std::string    hex;
+				if (SafeRead(from, code, sizeof(code))) {
+					for (uint32_t i = 0; i < sizeof(code); i++) {
+						hex +=
+						    (i == 0 ? "" : (i == CodeBytesBefore ? " | " : " ")) + Hex(code[i], 2);
+					}
+				} else {
+					hex = "unreadable";
+				}
+				LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 " code %s x%" PRIu32
+				     " from 0x%016" PRIx64 " (%" PRIu32
+				     " bytes, then | at the sampled address, then %" PRIu32 "): %s\n",
+				     r.campaign, b + 1, guest_top[0].c_str(), guest_top_count[0], from,
+				     CodeBytesBefore, CodeBytesAfter, hex.c_str());
+			}
+		}
+
+		// Registers and what they point at: when the busiest place changes.
+		const std::string this_top = top_n > 0 ? top[0] : std::string();
+		if (this_top.empty() || this_top == *prev_top) {
+			return;
+		}
+		*prev_top  = this_top;
+		uint32_t d = 0;
+		while (d < m_taken && !(m_samples[d].ok && location_keys[d] == this_top)) {
+			d++;
+		}
+		if (d == m_taken) {
+			return;
+		}
+		const RawSample& s = m_samples[d];
+		std::string      regs;
+		std::string      targets;
+		std::string      matches;
+		uint64_t         waits[StallProbe::RecentWaitSlots] = {};
+		const size_t     wait_count =
+		    StallProbe::RecentLongWaitAddresses(waits, StallProbe::RecentWaitSlots);
+		for (uint32_t i = 0; i < 16; i++) {
+			regs += std::string(i == 0 ? "" : " ") + RegNames[i] + "=0x" + Hex(s.gpr[i], 16);
+			if ((s.target_ok & (1u << i)) != 0) {
+				targets += std::string(targets.empty() ? "" : " ") + "[" + RegNames[i] + "]=0x" +
+				           Hex(s.target[i], 16);
+			}
+			for (size_t w = 0; w < wait_count; w++) {
+				const uint64_t diff =
+				    s.gpr[i] > waits[w] ? s.gpr[i] - waits[w] : waits[w] - s.gpr[i];
+				if (diff <= WaitAddressSlack) {
+					matches += std::string(matches.empty() ? "" : " ") + RegNames[i] +
+					           "=wait_addr_0x" + Hex(waits[w], 16) +
+					           (s.gpr[i] >= waits[w] ? "+0x" : "-0x") + Hex(diff);
+				}
+			}
+		}
+		LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 " regs sample=%" PRIu32
+		     " %s rip=0x%016" PRIx64 " rflags=0x%" PRIx64 "\n",
+		     r.campaign, b + 1, d, regs.c_str(), s.rip, s.rflags);
+		LOGF(
+		    "MainSampler: campaign=%" PRIu32 " burst=%" PRIu32 " reg_targets sample=%" PRIu32
+		    " (8 bytes at each register that points at readable memory, read while suspended) %s\n",
+		    r.campaign, b + 1, d, targets.empty() ? "none" : targets.c_str());
+		std::string recent;
+		for (size_t w = 0; w < wait_count; w++) {
+			recent += (w == 0 ? "0x" : ",0x") + Hex(waits[w], 16);
+		}
+		// A register near a watched address is a lead. None is inconclusive: the game may compute
+		// the address from a base and an offset, or keep it in memory rather than a register.
+		const std::string match_text =
+		    matches.empty()
+		        ? std::string("no_register_near=inconclusive (the address may be computed from a "
+		                      "base and an offset, or held in memory)")
+		        : "lead: " + matches;
+		LOGF("MainSampler: campaign=%" PRIu32 " burst=%" PRIu32
+		     " wait_reg_mem_match sample=%" PRIu32 " %s (recent long wait addresses: %s)\n",
+		     r.campaign, b + 1, d, match_text.c_str(),
+		     recent.empty() ? "none yet" : recent.c_str());
+	}
+
+	static std::string Hex(uint64_t value, int digits = 0) {
+		char buf[24];
+		std::snprintf(buf, sizeof(buf), "%0*" PRIx64, digits, value);
+		return buf;
+	}
+
+	struct ResumeFailure {
+		bool     failed   = false;
+		uint32_t sample   = 0;
+		uint32_t attempts = 0;
+		uint32_t error    = 0;
+	};
+
+	std::vector<RawSample> m_samples;
+	uint32_t               m_taken = 0; // samples attempted in the last burst
+	ResumeFailure          m_resume_failure;
+	uint64_t               m_qpc_frequency = 1;
+	FunctionList           m_hle;
+#else
+	void RunCampaign(const Request& r) {
+		static bool told = false;
+		if (!std::exchange(told, true)) {
+			LOGF("MainSampler: campaign=%" PRIu32 " trigger=join:%s: sampling another thread is "
+			     "implemented on Windows only; nothing sampled\n",
+			     r.campaign, r.joined);
+		}
+	}
+#endif
+
+	CampaignQueue m_queue;
+	std::thread   m_thread;
+};
+
+} // namespace
+
+void NoteJoin(const char* joined_name, int joiner_id, uint64_t main_host_tid, int main_id) {
+	if (joined_name == nullptr || !StallProbe::Enabled() ||
+	    std::strcmp(joined_name, JoinName()) != 0) {
+		return;
+	}
+	Detail::Request request;
+	request.main_host_tid = main_host_tid;
+	request.main_id       = main_id;
+	request.joiner_id     = joiner_id;
+	std::snprintf(request.joined, sizeof(request.joined), "%s", joined_name);
+	StallProbe::LocalTime(request.local_time, sizeof(request.local_time));
+	if (main_host_tid == 0) {
+		LOGF("MainSampler: join of %s at %s: main thread unknown; not sampled\n", request.joined,
+		     request.local_time);
+		return;
+	}
+	Sampler::Instance().Submit(request);
+}
