diff --git a/tests/DriverCacheFileTests.cpp b/tests/DriverCacheFileTests.cpp
new file mode 100644
index 00000000..edf6fbc3
--- /dev/null
+++ b/tests/DriverCacheFileTests.cpp
@@ -0,0 +1,146 @@
+#include "graphics/host_gpu/renderer/pipeline/driverCacheFile.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// Deterministic tests for the persistent Vulkan pipeline cache file format.
+// No GPU, Vulkan loader or game data is needed.
+
+namespace {
+
+using namespace Libs::Graphics::DriverCacheFile;
+
+void Check(bool value, const char* message) {
+	if (!value) {
+		std::fprintf(stderr, "DriverCacheFileTests: failed: %s\n", message);
+		std::abort();
+	}
+}
+
+DeviceIdentity TestDevice() {
+	DeviceIdentity identity {.vendor_id = 0x10de, .device_id = 0x2c02, .driver_version = 0x91f40000};
+	for (uint8_t i = 0; i < identity.pipeline_cache_uuid.size(); i++) {
+		identity.pipeline_cache_uuid[i] = static_cast<uint8_t>(i * 17);
+	}
+	return identity;
+}
+
+std::vector<uint8_t> TestPayload(size_t size) {
+	std::vector<uint8_t> payload(size);
+	for (size_t i = 0; i < size; i++) {
+		payload[i] = static_cast<uint8_t>((i * 31u + 7u) & 0xffu);
+	}
+	return payload;
+}
+
+void TestSignatureLayout() {
+	const auto signature = Signature(TestDevice());
+	Check(signature ==
+	          "KytyPC2:000010de:00002c02:91f40000:00112233445566778899aabbccddeeff\n",
+	      "signature text changed; existing caches would be invalidated");
+}
+
+void TestRoundTrip() {
+	const auto signature = Signature(TestDevice());
+	for (size_t size: {size_t {0}, size_t {1}, size_t {4096}, size_t {1u << 20}}) {
+		const auto payload = TestPayload(size);
+		const auto file    = Encode(signature, payload);
+		Check(file.size() == signature.size() + sizeof(uint64_t) + payload.size(),
+		      "encoded size is signature + hash + payload");
+		std::vector<uint8_t> decoded {1, 2, 3};
+		Check(Decode(signature, file, &decoded) == Status::Valid, "round trip is valid");
+		Check(decoded == payload, "round trip preserves payload");
+	}
+}
+
+// Byte layout must match files written by the pre-refactor Save().
+void TestLegacyLayoutCompatible() {
+	const auto signature = Signature(TestDevice());
+	const auto payload   = TestPayload(333);
+	std::string legacy   = signature;
+	const uint64_t hash  = XXH3_64bits(payload.data(), payload.size());
+	legacy.append(reinterpret_cast<const char*>(&hash), sizeof(hash));
+	legacy.append(reinterpret_cast<const char*>(payload.data()), payload.size());
+	const auto file = Encode(signature, payload);
+	Check(file.size() == legacy.size() && std::memcmp(file.data(), legacy.data(), legacy.size()) == 0,
+	      "Encode differs from the legacy byte layout");
+}
+
+void TestTruncated() {
+	const auto signature = Signature(TestDevice());
+	const auto file      = Encode(signature, TestPayload(64));
+	std::vector<uint8_t> decoded;
+	Check(Decode(signature, std::span(file).first(0), &decoded) == Status::TooSmall, "empty file");
+	Check(Decode(signature, std::span(file).first(signature.size() + 3), &decoded) == Status::TooSmall,
+	      "truncated header");
+	// Truncated payload keeps a valid header, so the checksum catches it.
+	Check(Decode(signature, std::span(file).first(file.size() - 1), &decoded) ==
+	          Status::PayloadCorrupted,
+	      "truncated payload");
+	Check(decoded.empty(), "payload cleared on failure");
+}
+
+void TestCorruptPayload() {
+	const auto signature = Signature(TestDevice());
+	auto       file      = Encode(signature, TestPayload(256));
+	file[file.size() / 2 + signature.size()] ^= 0x40u;
+	std::vector<uint8_t> decoded;
+	Check(Decode(signature, file, &decoded) == Status::PayloadCorrupted, "flipped payload bit");
+	Check(decoded.empty(), "corrupt payload is not returned");
+}
+
+void TestDriverUpdateInvalidates() {
+	auto       old_device = TestDevice();
+	const auto file       = Encode(Signature(old_device), TestPayload(128));
+	std::vector<uint8_t> decoded;
+
+	auto driver_update = old_device;
+	driver_update.driver_version++;
+	Check(Decode(Signature(driver_update), file, &decoded) == Status::DeviceMismatch,
+	      "driver version change");
+
+	auto uuid_change = old_device;
+	uuid_change.pipeline_cache_uuid[15] ^= 1u;
+	Check(Decode(Signature(uuid_change), file, &decoded) == Status::DeviceMismatch,
+	      "pipelineCacheUUID change");
+
+	auto new_gpu = old_device;
+	new_gpu.device_id = 0x2684;
+	Check(Decode(Signature(new_gpu), file, &decoded) == Status::DeviceMismatch, "GPU change");
+}
+
+void TestForeignFile() {
+	const auto signature = Signature(TestDevice());
+	std::vector<uint8_t> file(signature.size() + 64, 0);
+	std::memcpy(file.data(), "KytyPC1:", 8);
+	std::vector<uint8_t> decoded;
+	Check(Decode(signature, file, &decoded) == Status::FormatMismatch, "older format tag");
+	std::memset(file.data(), 'x', signature.size());
+	Check(Decode(signature, file, &decoded) == Status::FormatMismatch, "random file");
+}
+
+void TestStatusNames() {
+	for (auto status: {Status::Valid, Status::TooSmall, Status::TooLarge, Status::FormatMismatch,
+	                   Status::DeviceMismatch, Status::PayloadCorrupted}) {
+		Check(std::strcmp(StatusName(status), "unknown") != 0, "every status has a name");
+	}
+}
+
+} // namespace
+
+int main() {
+	TestSignatureLayout();
+	TestRoundTrip();
+	TestLegacyLayoutCompatible();
+	TestTruncated();
+	TestCorruptPayload();
+	TestDriverUpdateInvalidates();
+	TestForeignFile();
+	TestStatusNames();
+	std::printf("DriverCacheFileTests: all tests passed\n");
+	return 0;
+}
