@@ -0,0 +1,111 @@
+#ifndef GRAPHICS_HOST_GPU_RENDERER_PIPELINE_DRIVER_CACHE_FILE_H_
+#define GRAPHICS_HOST_GPU_RENDERER_PIPELINE_DRIVER_CACHE_FILE_H_
+
+// On-disk format of the persistent Vulkan pipeline cache (_PipelineCache/<TITLE>.bin):
+//
+//   "KytyPC2:<vendor>:<device>:<driver>:<pipelineCacheUUID>\n"   text signature
+//   uint64_t XXH3_64bits(payload)                                 native byte order
+//   payload                                                       vkGetPipelineCacheData()
+//
+// Kept free of Vulkan and file I/O so the format can be tested without a GPU.
+
+#include <xxhash.h>
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Libs::Graphics::DriverCacheFile {
+
+constexpr std::string_view SignatureTag = "KytyPC2:";
+
+struct DeviceIdentity {
+	uint32_t                 vendor_id      = 0;
+	uint32_t                 device_id      = 0;
+	uint32_t                 driver_version = 0;
+	std::array<uint8_t, 16> pipeline_cache_uuid {};
+};
+
+enum class Status {
+	Valid,
+	TooSmall,          // truncated or empty file
+	TooLarge,          // larger than the reader supports
+	FormatMismatch,    // not a Kyty cache file, or an older/newer format
+	DeviceMismatch,    // different GPU, driver version or driver cache UUID
+	PayloadCorrupted,  // signature matches, payload hash does not
+};
+
+inline const char* StatusName(Status status) {
+	switch (status) {
+		case Status::Valid: return "valid";
+		case Status::TooSmall: return "file too small";
+		case Status::TooLarge: return "file too large";
+		case Status::FormatMismatch: return "unknown file format";
+		case Status::DeviceMismatch: return "GPU or driver changed";
+		case Status::PayloadCorrupted: return "payload checksum mismatch";
+	}
+	return "unknown";
+}
+
+inline std::string Signature(const DeviceIdentity& identity) {
+	std::string uuid;
+	uuid.reserve(identity.pipeline_cache_uuid.size() * 2);
+	constexpr char hex[] = "0123456789abcdef";
+	for (const uint8_t byte: identity.pipeline_cache_uuid) {
+		uuid.push_back(hex[byte >> 4u]);
+		uuid.push_back(hex[byte & 0xfu]);
+	}
+	char ids[32] = {};
+	std::snprintf(ids, sizeof(ids), "%08x:%08x:%08x:", identity.vendor_id, identity.device_id,
+	              identity.driver_version);
+	return std::string(SignatureTag) + ids + uuid + "\n";
+}
+
+inline std::vector<uint8_t> Encode(std::string_view signature, std::span<const uint8_t> payload) {
+	const uint64_t       hash = XXH3_64bits(payload.data(), payload.size());
+	std::vector<uint8_t> file(signature.size() + sizeof(hash) + payload.size());
+	std::memcpy(file.data(), signature.data(), signature.size());
+	std::memcpy(file.data() + signature.size(), &hash, sizeof(hash));
+	if (!payload.empty()) {
+		std::memcpy(file.data() + signature.size() + sizeof(hash), payload.data(), payload.size());
+	}
+	return file;
+}
+
+// Parses a whole cache file. On Valid, `payload` holds the driver data; otherwise it is cleared.
+inline Status Decode(std::string_view expected_signature, std::span<const uint8_t> file,
+                     std::vector<uint8_t>* payload) {
+	payload->clear();
+	const size_t header_size = expected_signature.size() + sizeof(uint64_t);
+	if (file.size() > std::numeric_limits<uint32_t>::max()) {
+		return Status::TooLarge;
+	}
+	if (file.size() < header_size) {
+		return Status::TooSmall;
+	}
+	const std::string_view signature(reinterpret_cast<const char*>(file.data()),
+	                                 expected_signature.size());
+	if (signature != expected_signature) {
+		const bool same_tag =
+		    expected_signature.starts_with(SignatureTag) && signature.starts_with(SignatureTag);
+		return same_tag ? Status::DeviceMismatch : Status::FormatMismatch;
+	}
+	uint64_t stored_hash = 0;
+	std::memcpy(&stored_hash, file.data() + expected_signature.size(), sizeof(stored_hash));
+	const auto data = file.subspan(header_size);
+	if (XXH3_64bits(data.data(), data.size()) != stored_hash) {
+		return Status::PayloadCorrupted;
+	}
+	payload->assign(data.begin(), data.end());
+	return Status::Valid;
+}
+
+} // namespace Libs::Graphics::DriverCacheFile
+
+#endif // GRAPHICS_HOST_GPU_RENDERER_PIPELINE_DRIVER_CACHE_FILE_H_
