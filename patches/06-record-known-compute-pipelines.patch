+// Compute recordings contain locally translated SPIR-V + the *actual* Vulkan
+// pipeline recipe. They are only written with explicit user opt-in. In
+// particular, no guest pointers, shader source archive or personal paths are
+// sent anywhere. Recordings are for the same GPU/driver and versioned format.
+std::string PipelineCacheTitleId();
+
+bool RecordComputeEnabled() {
+    const char* value = std::getenv("KYTY_RECORD_COMPUTE");
+    return value != nullptr && std::strcmp(value, "1") == 0;
+}
+
+std::filesystem::path ComputeRecordingDirectory() {
+    std::string title = PipelineCacheTitleId();
+    if (title.empty()) return {};
+    std::filesystem::path root("_PipelineCache");
+    if (const char* override_path = std::getenv("KYTY_PIPELINE_CACHE_DIR");
+        override_path != nullptr && *override_path != 0) {
+        std::filesystem::path candidate(override_path);
+        if (candidate.is_absolute()) root = std::move(candidate);
+    }
+    return root / "compute_recordings" / title;
+}
