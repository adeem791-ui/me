+void TextureCache::LogMemoryStats() {
+	std::scoped_lock lock {m_lock};
+	size_t           images    = 0;
+	size_t           modified  = 0;
+	uint64_t         accounted = 0;
+	std::vector<std::pair<uint64_t, uint32_t>> surfaces;
+	m_slot_images.ForEach([&](ImageId, const Image& image) {
+		if (!image.registered) {
+			return;
+		}
+		++images;
+		accounted += image.AccountedSize();
+		if (image.IsGpuModified()) {
+			++modified;
+		}
+		surfaces.emplace_back(image.info.data.address,
+		                      static_cast<uint32_t>(image.info.pixel_format));
+	});
+	std::sort(surfaces.begin(), surfaces.end());
+	const auto distinct =
+	    static_cast<size_t>(std::unique(surfaces.begin(), surfaces.end()) - surfaces.begin());
+	// Images that share a guest address and format are duplicates of one surface.
+	LOGF("TextureCache stats: images=%zu accounted=%" PRIu64 " gpu_modified=%zu "
+	     "same_surface_duplicates=%zu
+",
+	     images, accounted, modified, images - distinct);
+}
