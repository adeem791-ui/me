+void RenderContext::LogHeartbeat() {
+	// One line per 5 s telling which stage keeps moving during a black screen. CPU-side counts
+	// only: gpu_wait_ms is time the CPU spent blocked on the GPU, not GPU execution time.
+	using Common::DebugCounters::Counter;
+	if (!Common::DebugCounters::Enabled()) {
+		static bool told = false;
+		if (!told) {
+			told = true;
+			LOGF("Heartbeat: counters are off; start with --perf-overlay true (or press F2) to "
+			     "log draws/submits/flips every 5 s\n");
+		}
+		return;
+	}
+	static constexpr Counter Tracked[] = {
+	    Counter::QueueSubmits,   Counter::Draws,           Counter::Dispatches,
+	    Counter::FlipsRequested, Counter::DroppedPresents, Counter::GpuWaits,
+	    Counter::GpuWaitNs,      Counter::PipelinesCreated, Counter::PipelineCreateNs,
+	    Counter::TextureEvictions, Counter::AudioUnderruns, Counter::GuestFileReadBytes};
+	static uint64_t last[std::size(Tracked)] {};
+	uint64_t        delta[std::size(Tracked)] {};
+	for (size_t i = 0; i < std::size(Tracked); i++) {
+		const auto now = Common::DebugCounters::Get(Tracked[i]);
+		delta[i]       = now - last[i];
+		last[i]        = now;
+	}
+	auto& master = m_command_scheduler.GetMasterSemaphore();
+	master.Refresh();
+	const uint64_t current = master.CurrentTick();
+	const uint64_t done    = master.KnownGpuTick();
+	LOGF("Heartbeat(5s): submits=%" PRIu64 " draws=%" PRIu64 " dispatches=%" PRIu64
+	     " flips_requested=%" PRIu64 " dropped_presents=%" PRIu64 " cpu_waits_on_gpu=%" PRIu64
+	     " cpu_wait_on_gpu_ms=%" PRIu64 " pipelines_created=%" PRIu64 " pipeline_create_ms=%" PRIu64
+	     " texture_evictions=%" PRIu64 " audio_underruns=%" PRIu64 " guest_file_read_kib=%" PRIu64
+	     " gpu_ticks_behind=%" PRIu64 "\n",
+	     delta[0], delta[1], delta[2], delta[3], delta[4], delta[5], delta[6] / 1000000,
+	     delta[7], delta[8] / 1000000, delta[9], delta[10], delta[11] / 1024,
+	     current > done ? current - done - 1 : 0);
 }
 
