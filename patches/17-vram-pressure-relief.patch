diff --git a/tests/VramReliefTests.cpp b/tests/VramReliefTests.cpp
new file mode 100644
index 00000000..9213df03
--- /dev/null
+++ b/tests/VramReliefTests.cpp
@@ -0,0 +1,60 @@
+#include "graphics/host_gpu/renderer/vramRelief.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+// When the mid-submission VRAM relief acts. No GPU needed.
+
+namespace {
+
+using namespace Libs::Graphics::VramRelief;
+constexpr uint64_t GiB = 1024 * MiB;
+
+void Check(bool value, const char* message) {
+	if (!value) {
+		std::fprintf(stderr, "VramReliefTests: failed: %s\n", message);
+		std::abort();
+	}
+}
+
+void TestNoBudget() {
+	Check(!Decide(0, GiB, 100 * GiB, 0).act, "no budget reported: never act");
+}
+
+void TestTriggerAndTarget() {
+	// Ahmad's RTX 5080: VMA budget 15.16 GB; GetTotalMemoryBudget keeps 1 GiB back -> ~14.1 GB.
+	const uint64_t budget = 14119 * MiB;
+	const auto     below  = Decide(budget, GiB, budget - GiB - 1, 0);
+	Check(!below.act, "below trigger: no action");
+	Check(below.trigger == budget - GiB, "trigger is budget minus headroom");
+	Check(below.target == budget - 2 * GiB, "target leaves two headrooms below budget");
+	Check(Decide(budget, GiB, budget - GiB, 0).act, "at trigger: act");
+	Check(Decide(budget, GiB, budget + GiB, 0).act, "over budget: act");
+}
+
+void TestHeadroomCapped() {
+	// A huge configured headroom must not make relief run all the time on a small GPU.
+	const uint64_t budget = 4 * GiB;
+	const auto     plan   = Decide(budget, 4 * GiB, 0, 0);
+	Check(plan.trigger == budget - GiB, "headroom capped at a quarter of the budget");
+	Check(plan.target >= budget / 2, "target never below half the budget");
+}
+
+void TestRetryBackoff() {
+	const uint64_t budget = 14 * GiB;
+	const uint64_t stuck  = 13 * GiB + 512 * MiB;
+	Check(!Decide(budget, GiB, stuck, stuck).act, "no retry at the same level after a failed attempt");
+	Check(!Decide(budget, GiB, stuck + RetryGrowth - 1, stuck).act, "no retry before 256 MiB growth");
+	Check(Decide(budget, GiB, stuck + RetryGrowth, stuck).act, "retry after 256 MiB growth");
+}
+
+} // namespace
+
+int main() {
+	TestNoBudget();
+	TestTriggerAndTarget();
+	TestHeadroomCapped();
+	TestRetryBackoff();
+	std::printf("VramReliefTests: all tests passed\n");
+	return 0;
+}
