+TextureCache::ReclaimResult TextureCache::ReclaimUnusedImages(uint64_t bytes_wanted,
+                                                             size_t   max_images) {
+	std::scoped_lock lock {m_lock};
+	ReclaimResult    result;
+	if (m_gc_tick == 0 || bytes_wanted == 0 || max_images == 0) {
+		return result;
+	}
+	// Everything touched since the last collector pass carries tick m_gc_tick, including every
+	// image recorded into the open command buffer since then, so it is excluded here. Older GPU
+	// work is protected by DeleteImage's deferred destruction.
+	std::vector<ImageId> candidates;
+	candidates.reserve(std::min<size_t>(max_images * 2, 8192));
+	m_lru_cache.ForEachItemBelow(m_gc_tick - 1, [&](ImageId id) {
+		candidates.push_back(id);
+		return candidates.size() >= max_images * 2;
+	});
+	for (const auto id: candidates) {
+		if (result.images >= max_images || result.bytes >= bytes_wanted) {
+			break;
+		}
+		auto* owner = m_slot_images.try_get(id);
+		if (owner == nullptr || !owner->registered || owner->depth_id) {
+			continue; // stencil associations go with their depth owner
+		}
+		if (owner->heap_refs.load(std::memory_order_relaxed) != 0u) {
+			continue; // resident image heaps sample it without touching it
+		}
+		if (owner->IsGpuModified()) {
+			continue; // contents exist only on the GPU; never dropped here
+		}
+		// Freeing a depth owner also frees its stencil associations (DeleteImage), which would
+		// drop any stencil contents that exist only on the GPU.
+		const bool stencil_modified =
+		    std::any_of(owner->stencil_ids.begin(), owner->stencil_ids.end(), [&](ImageId stencil) {
+			    const auto* association = m_slot_images.try_get(stencil);
+			    return association != nullptr && association->IsGpuModified();
+		    });
+		if (stencil_modified) {
+			continue;
+		}
+		uint64_t bytes = owner->AccountedSize();
+		for (const auto stencil: owner->stencil_ids) {
+			if (const auto* association = m_slot_images.try_get(stencil)) {
+				bytes += association->AccountedSize();
+			}
+		}
+		FreeImage(id);
+		result.images++;
+		result.bytes += bytes;
+		Common::DebugCounters::Add(Common::DebugCounters::Counter::TextureEvictions);
+	}
+	return result;
+}
