+uint64_t GraphicContext::GetDeviceMemoryCommitted() const {
+	if (!CanReportMemoryUsage() || allocator == nullptr) {
+		return 0;
+	}
+	VmaBudget budgets[VK_MAX_MEMORY_HEAPS] {};
+	vmaGetHeapBudgets(allocator, budgets);
+	const bool discrete =
+	    physical_device_properties.deviceType == vk::PhysicalDeviceType::eDiscreteGpu;
+	uint64_t committed = 0;
+	for (uint32_t heap = 0; heap < physical_device_memory_properties.memoryHeapCount; heap++) {
+		const bool device_local =
+		    static_cast<bool>(physical_device_memory_properties.memoryHeaps[heap].flags &
+		                      vk::MemoryHeapFlagBits::eDeviceLocal);
+		if (discrete && !device_local) {
+			continue;
+		}
+		const uint64_t usage  = budgets[heap].usage;
+		const uint64_t blocks = budgets[heap].statistics.blockBytes;
+		const uint64_t used   = budgets[heap].statistics.allocationBytes;
+		const uint64_t free_in_blocks = blocks > used ? blocks - used : 0;
+		committed += usage > free_in_blocks ? usage - free_in_blocks : 0;
+	}
+	return committed;
+}
