@@ -0,0 +1,45 @@
+#ifndef GRAPHICS_HOST_GPU_RENDERER_VRAM_RELIEF_H_
+#define GRAPHICS_HOST_GPU_RENDERER_VRAM_RELIEF_H_
+
+// When RenderContext::RelieveMemoryPressure acts. Pure, so it can be tested without a GPU.
+
+#include <algorithm>
+#include <cstdint>
+
+namespace Libs::Graphics::VramRelief {
+
+inline constexpr uint64_t MiB = 1024ull * 1024;
+// After relief fails to get under the trigger, wait for this much more growth before trying
+// (and stalling the GPU) again.
+inline constexpr uint64_t RetryGrowth = 256 * MiB;
+
+struct Plan {
+	bool     act    = false;
+	uint64_t target = 0; // committed bytes to evict down to (hysteresis below the trigger)
+	uint64_t trigger = 0;
+};
+
+// budget: GraphicContext::GetTotalMemoryBudget(); committed: GetDeviceMemoryCommitted();
+// stuck_at: committed bytes when the last attempt could not get under the trigger (0 = none).
+[[nodiscard]] inline Plan Decide(uint64_t budget, uint64_t headroom, uint64_t committed,
+                                 uint64_t stuck_at) {
+	Plan plan;
+	if (budget == 0) {
+		return plan;
+	}
+	headroom     = std::min<uint64_t>(headroom, budget / 4);
+	plan.trigger = budget - headroom;
+	plan.target  = std::max<uint64_t>(budget - std::min<uint64_t>(2 * headroom, budget), budget / 2);
+	if (committed < plan.trigger) {
+		return plan;
+	}
+	if (stuck_at != 0 && committed < stuck_at + RetryGrowth) {
+		return plan;
+	}
+	plan.act = true;
+	return plan;
+}
+
+} // namespace Libs::Graphics::VramRelief
+
+#endif // GRAPHICS_HOST_GPU_RENDERER_VRAM_RELIEF_H_
