+struct VramReliefSettings {
+	bool     enabled  = true;
+	uint64_t headroom = 1024ull * 1024 * 1024;
+};
+
+const VramReliefSettings& GetVramReliefSettings() {
+	static const VramReliefSettings settings = [] {
+		VramReliefSettings out;
+		if (const char* value = std::getenv("KYTY_VRAM_RECOVERY"); value != nullptr) {
+			out.enabled = std::strcmp(value, "0") != 0;
+		}
+		if (const char* value = std::getenv("KYTY_VRAM_HEADROOM_MB"); value != nullptr) {
+			const auto mb = std::strtoull(value, nullptr, 10);
+			out.headroom  = std::clamp<uint64_t>(mb, 256, 4096) * 1024 * 1024;
+		}
+		LOGF("VRAM relief: %s, headroom=%" PRIu64 " MiB (KYTY_VRAM_RECOVERY, KYTY_VRAM_HEADROOM_MB)\n",
+		     out.enabled ? "enabled" : "disabled", out.headroom / (1024 * 1024));
+		return out;
+	}();
+	return settings;
+}
+
+} // namespace
+
+void RenderContext::RelieveMemoryPressure() {
+	const auto& settings = GetVramReliefSettings();
+	auto&       graphics = GetGraphics();
+	if (!settings.enabled || !graphics.CanReportMemoryUsage()) {
+		return;
+	}
+	const uint64_t budget = graphics.GetTotalMemoryBudget();
+	if (budget == 0) {
+		return;
+	}
+	using VramRelief::MiB;
+	const uint64_t before = graphics.GetDeviceMemoryCommitted();
+	// When relief last found nothing to release, Decide does not stall the GPU again on every
+	// draw; it retries once usage has grown by another VramRelief::RetryGrowth.
+	const auto plan = VramRelief::Decide(budget, settings.headroom, before, m_vram_relief.stuck_at);
+	if (before < plan.trigger) {
+		m_vram_relief.stuck_at = 0;
+	}
+	if (!plan.act) {
+		return;
+	}
+	const uint64_t trigger = plan.trigger;
+	const uint64_t target  = plan.target;
+	const auto     start   = std::chrono::steady_clock::now();
+	m_vram_relief.attempts++;
+	const auto reclaim = m_texture_cache.ReclaimUnusedImages(before - target, 4096);
+	m_vram_relief.images += reclaim.images;
+	m_vram_relief.bytes += reclaim.bytes;
+
+	// Evicted (and earlier collected) images are destroyed only once the GPU passes the tick
+	// they were last used at. Finish here, at a draw/dispatch boundary where the scheduler may
+	// be restarted, so the memory is back before this draw allocates.
+	bool waited = false;
+	if ((reclaim.images > 0 || m_command_scheduler.PendingOperationCount() > 0) &&
+	    m_command_scheduler.Active() && !CommandScheduler::InDeferredOperation()) {
+		m_command_scheduler.Finish();
+		m_vram_relief.gpu_waits++;
+		waited = true;
+	}
+	const uint64_t after = graphics.GetDeviceMemoryCommitted();
+	m_vram_relief.reclaimed += before > after ? before - after : 0;
+	m_vram_relief.stuck_at = after >= trigger ? std::max<uint64_t>(after, 1) : 0;
+	const auto elapsed_ms = std::chrono::duration<double, std::milli>(
+	                            std::chrono::steady_clock::now() - start)
+	                            .count();
+	if (m_vram_relief.logged < 32 || (m_vram_relief.attempts % 64) == 0) {
+		m_vram_relief.logged++;
+		LOGF("VRAM relief #%" PRIu64 ": committed_before=%" PRIu64 "MiB budget=%" PRIu64
+		     "MiB trigger=%" PRIu64 "MiB evicted_images=%zu evicted=%" PRIu64
+		     "MiB gpu_wait=%d committed_after=%" PRIu64 "MiB released=%" PRId64 "MiB took=%.1fms%s\n",
+		     m_vram_relief.attempts, before / MiB, budget / MiB, trigger / MiB, reclaim.images,
+		     reclaim.bytes / MiB, waited ? 1 : 0, after / MiB,
+		     (static_cast<int64_t>(before) - static_cast<int64_t>(after)) / static_cast<int64_t>(MiB),
+		     elapsed_ms,
+		     after >= trigger ? " (still above trigger: nothing more is safely evictable now)" : "");
+	}
+}
