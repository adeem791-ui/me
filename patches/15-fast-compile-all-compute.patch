diff --git a/src/graphics/host_gpu/renderer/pipeline/shaders.cpp b/src/graphics/host_gpu/renderer/pipeline/shaders.cpp
index 528039e6..342c107f 100644
--- a/src/graphics/host_gpu/renderer/pipeline/shaders.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/shaders.cpp
@@ -646,17 +646,19 @@ void CreatePipelineInternal(GraphicContext& graphics, PipelineCache::Pipeline& p
 	info.layout            = pipeline.pipeline_layout;
 	info.basePipelineIndex = -1;
 
-	// A huge Yotei compute shader (~407k SPIR-V words) repeatedly gets stuck
-	// in driver pipeline compilation. DISABLE_OPTIMIZATION is a Vulkan core
+	// Measured on the Yotei title screen (RTX 5080): across 585 compute pipeline
+	// compiles in one 5-minute session, 36 took over a second; the two worst (a
+	// 467k-word shader) took 26-28s EACH, and a recompiled 86k-word shader alone
+	// added 21 compiles averaging 1.5s. DISABLE_OPTIMIZATION is a Vulkan core
 	// *hint*, not a timeout; it keeps shader semantics intact but can trade
-	// runtime performance for a much shorter driver compilation path.
-	// Only try it on very large compute shaders; allow safe A/B rollback.
-	constexpr uint32_t LargeComputeShaderWords = 262144;
+	// runtime performance for a much shorter driver compilation path. It was
+	// previously gated to shaders >= 262144 SPIR-V words, which missed the 86k
+	// and 211k-word shaders above -- most of the measured stall time. Apply it
+	// to every compute pipeline; KYTY_LARGE_CS_FAST_COMPILE=0 restores the old
+	// behaviour (full optimization, slower compiles) for A/B comparison.
 	const char* fast_compile_env = std::getenv("KYTY_LARGE_CS_FAST_COMPILE");
-	const bool fast_compile_enabled = fast_compile_env == nullptr ||
-	                                  std::strcmp(fast_compile_env, "0") != 0;
-	const bool fast_compile = fast_compile_enabled &&
-	                          compute_program.spirv_words >= LargeComputeShaderWords;
+	const bool fast_compile = fast_compile_env == nullptr ||
+	                          std::strcmp(fast_compile_env, "0") != 0;
 	if (fast_compile) {
 		info.flags |= vk::PipelineCreateFlagBits::eDisableOptimization;
 	}
